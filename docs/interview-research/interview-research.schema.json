{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeArena interview research file, v1",
  "description": "One file = one company + one role + one experience level + one hiring region. Questions are SOURCE MATERIAL: the importer loads them as drafts for human review, never as published questions.",
  "type": "object",
  "required": ["schema_version", "research", "sources", "rounds", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "codearena-interview-import/1" },
    "research": {
      "type": "object",
      "required": ["company", "role", "experience_level", "hiring_region", "target_year", "researched_on", "limitations"],
      "additionalProperties": false,
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1, "description": "The exact job title, as in the job description" },
        "experience_level": { "enum": ["FRESHER", "0-1_YEARS", "1-3_YEARS", "3-5_YEARS", "5_PLUS_YEARS"] },
        "hiring_region": { "type": "string", "minLength": 1 },
        "target_year": { "type": "integer", "minimum": 2020, "maximum": 2100 },
        "researched_on": { "type": "string", "format": "date", "description": "YYYY-MM-DD, the day the research was done" },
        "researcher": { "type": "string", "description": "Who or what produced this file (a person, or the AI tool and its version)" },
        "job_description_url": { "type": ["string", "null"] },
        "job_description_summary": { "type": ["string", "null"] },
        "required_skills": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" }, "description": "What could not be found or verified. An empty list is only acceptable if nothing was missing." }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "kind", "url", "accessed_on"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^S[0-9]{1,3}$", "description": "S1, S2 ... referenced by questions and rounds" },
          "kind": { "enum": ["OFFICIAL_CAREERS", "OFFICIAL_COMPANY_BLOG", "JOB_DESCRIPTION", "CANDIDATE_REPORT", "FORUM_POST", "REPUTABLE_GUIDE", "OTHER"] },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "published_on": { "type": ["string", "null"], "description": "YYYY-MM-DD, or YYYY-MM, or YYYY; null if the page shows no date" },
          "accessed_on": { "type": "string", "format": "date" },
          "reliability_note": { "type": "string", "description": "Why this source is or is not trustworthy" }
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_id", "name", "order", "evidence"],
        "additionalProperties": false,
        "properties": {
          "round_id": { "type": "string", "pattern": "^R[0-9]{1,2}$" },
          "name": { "type": "string" },
          "category": { "enum": ["ONLINE_ASSESSMENT", "APTITUDE_REASONING", "CODING_ASSESSMENT", "DSA", "CORE_TECHNICAL", "ROLE_TECHNICAL", "PROJECT_DISCUSSION", "SYSTEM_DESIGN", "CASE_STUDY", "MANAGERIAL_BEHAVIORAL", "HR"] },
          "order": { "type": "integer", "minimum": 1 },
          "evidence": { "enum": ["DOCUMENTED", "REPORTED", "PROPOSED"], "description": "PROPOSED = a suggested preparation structure with no evidence that the company runs this round" },
          "duration_min": { "type": ["integer", "null"] },
          "description": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]{1,3}$" } }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "round_id", "topic", "question_type", "difficulty", "prompt", "evidence_class", "verification_status", "confidence", "originality_status", "relevance_to_role"],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$", "description": "Unique within the whole dataset, e.g. EXAMPLECORP-SWE-R2-001" },
          "round_id": { "type": "string", "pattern": "^R[0-9]{1,2}$" },
          "topic": { "type": "string" },
          "subtopic": { "type": "string" },
          "question_type": { "enum": ["CODING", "MCQ", "MULTI_SELECT", "TECHNICAL_CONCEPT", "BEHAVIORAL", "HR", "SYSTEM_DESIGN", "CASE_STUDY", "PROJECT_DISCUSSION", "APTITUDE"] },
          "difficulty": { "enum": ["EASY", "MEDIUM", "HARD"] },
          "prompt": { "type": "string", "minLength": 15, "description": "The complete question as a candidate would hear or read it, in your own words" },
          "relevance_to_role": { "type": "string", "description": "Which part of the job description or required skills this tests" },
          "evidence_class": {
            "enum": ["A_DOCUMENTED", "B_CANDIDATE_REPORTED", "C_INFERRED_FROM_JD", "D_PRACTICE"],
            "description": "A = the company or an official source documents this question. B = a candidate reports being asked it. C = a question for a skill the official job description requires (no claim anyone was asked it). D = an original practice question written for preparation (never claimed to be asked)."
          },
          "source_ids": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]{1,3}$" }, "description": "Required (at least one) for A, B and C; must be empty for D" },
          "times_reported": { "type": "integer", "minimum": 0, "description": "How many INDEPENDENT sources report this question (0 for C and D)" },
          "verification_status": { "enum": ["VERIFIED", "UNVERIFIED", "CONFLICTING", "NEEDS_REVIEW"], "description": "VERIFIED only when two independent sources agree or an official source states it" },
          "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "originality_status": { "enum": ["ORIGINAL", "PARAPHRASED", "NOT_CHECKED"], "description": "Never copied verbatim from a source" },
          "expected_answer": { "type": "string", "description": "A correct, complete model answer. If you are not sure it is correct, say so in notes and set verification_status NEEDS_REVIEW." },
          "rubric": {
            "type": "array",
            "items": { "type": "object", "required": ["criterion", "weight"], "additionalProperties": false, "properties": { "criterion": { "type": "string" }, "weight": { "type": "integer", "minimum": 1, "maximum": 10 } } }
          },
          "key_concepts": { "type": "array", "items": { "type": "string" } },
          "follow_ups": { "type": "array", "items": { "type": "string" } },
          "common_mistakes": { "type": "array", "items": { "type": "string" } },
          "suggested_time_min": { "type": ["integer", "null"], "minimum": 1 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "coding": {
            "type": "object",
            "description": "Required when question_type is CODING",
            "required": ["problem_statement", "input_format", "output_format", "constraints", "samples", "edge_cases", "expected_algorithm", "time_complexity", "space_complexity", "hidden_test_categories"],
            "additionalProperties": false,
            "properties": {
              "problem_statement": { "type": "string", "description": "Language-neutral" },
              "input_format": { "type": "string" },
              "output_format": { "type": "string" },
              "constraints": { "type": "string" },
              "samples": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["input", "output"], "additionalProperties": false, "properties": { "input": { "type": "string" }, "output": { "type": "string" }, "explanation": { "type": "string" } } } },
              "edge_cases": { "type": "array", "items": { "type": "string" } },
              "expected_algorithm": { "type": "string" },
              "time_complexity": { "type": "string" },
              "space_complexity": { "type": "string" },
              "hidden_test_categories": { "type": "array", "items": { "type": "string" } },
              "hidden_tests": { "type": "array", "description": "Optional, only if you verified the expected outputs by hand or by running a reference solution", "items": { "type": "object", "required": ["input", "output"], "additionalProperties": false, "properties": { "input": { "type": "string" }, "output": { "type": "string" } } } }
            }
          },
          "mcq": {
            "type": "object",
            "description": "Required when question_type is MCQ or MULTI_SELECT",
            "required": ["options", "correct_options", "explanation"],
            "additionalProperties": false,
            "properties": {
              "options": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string" } },
              "correct_options": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "description": "Zero-based positions in options" },
              "explanation": { "type": "string" },
              "distractor_notes": { "type": "string" }
            }
          },
          "behavioral": {
            "type": "object",
            "description": "Required when question_type is BEHAVIORAL or HR",
            "required": ["competency", "star_guidance", "positive_signals", "negative_signals"],
            "additionalProperties": false,
            "properties": {
              "competency": { "type": "string" },
              "star_guidance": { "type": "string" },
              "positive_signals": { "type": "array", "items": { "type": "string" } },
              "negative_signals": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
