// CodeArena — Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
  // Placement Clerk — always institute-scoped (User.instituteId required for this role), focused
  // on Placement Cell operations (student search/export, Company Master). Never gains Learning
  // Management or Test Management access — those routes stay ADMIN/ADMIN+STAFF and simply don't
  // list CLERK, so it's excluded by default rather than needing an explicit block.
  CLERK
}

// Orthogonal to `Role` — an account's disciplinary/access state, kept in sync with the older
// `isActive` boolean (isActive = accountStatus === "ACTIVE") so every existing isActive check
// platform-wide (login gate, Student flows, etc.) needs zero changes. Only the Staff & Clerk
// Management Dashboard exposes LOCKED/SUSPENDED transitions; Student account management still
// only ever toggles between ACTIVE/INACTIVE via the existing isActive field.
enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
  INACTIVE
}

enum QuestionType {
  CODING
  MCQ
  TRUE_FALSE
  MULTISELECT
  SQL
}

// Employability & Subject Readiness module's question-quality workflow (Question.questionStatus).
// Only questions that reach VERIFIED or PUBLISHED are eligible for a Readiness assessment
// blueprint unless an admin explicitly opts a specific assessment into including drafts.
enum QuestionStatus {
  DRAFT
  UNDER_REVIEW
  VERIFIED
  PUBLISHED
  ARCHIVED
}

model Institute {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?
  address   String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Certificate branding — stored as a data URL, same pattern as User.profilePhotoUrl (no
  // external object storage on this platform).
  logoUrl String?

  // Enterprise security config (Section 2 of the enterprise spec) — per-institute, so one
  // institute's stricter policy doesn't force it on every other institute sharing the platform.
  passwordExpiryDays   Int?     // null = passwords never expire
  passwordHistoryDepth Int      @default(3) // block reuse of this many previous passwords
  singleSessionOnly    Boolean  @default(false) // true = a new login revokes this account's other active sessions
  aiHintsEnabled        Boolean @default(false) // Learning Module coding hints — off by default, admin opt-in

  // Attendance Management: display-only warning threshold shown on a student's own attendance
  // view when their per-subject percentage falls below it. Null = no threshold configured, no
  // warning shown — this never blocks anything (tests, login, etc.), purely informational.
  attendanceMinPercent Int?

  // Student Profile Completion: when true, a STUDENT at this institute is blocked from
  // everything except the Profile page + logout until their Personal Academic & Info section is
  // complete (see backend/src/utils/studentProfileCompletion.js). Off by default — existing
  // students are never retroactively locked out unless an admin opts their institute in.
  requireProfileCompletion Boolean @default(false)

  // Daily/Weekly Challenge automation: opt-in per institute so the scheduler's blast radius stays
  // bounded (Global always auto-publishes; a specific institute's own challenge only auto-publishes
  // once an admin flips this on — see utils/challengeScheduler.js). Off by default.
  autoScheduleChallenges Boolean @default(false)

  // Digital marksheet signature block — institute-level (not per-exam), capped in the admin UI at
  // a handful of rows. Stored as JSON rather than fixed columns for flexibility (an institute might
  // have a Principal but no separate Director, etc.) — array of { title, name, signatureImageUrl },
  // signatureImageUrl a data URL, same storage convention as `logoUrl`/`User.profilePhotoUrl` (no
  // external object storage on this platform).
  marksheetSignatories Json?

  classes         Class[]
  users           User[]
  questions       Question[]
  questionFolders QuestionFolder[]
  departments     Department[]
  academicGroups  AcademicGroup[]
  courseAssignments CourseInstituteAssignment[]
  talentPools     TalentPoolInstitute[]
  talentPoolAttendanceAssignments StaffClassAssignment[] @relation("TalentPoolAttendanceInstitute")
  dailyChallenges  DailyChallenge[]
  weeklyChallenges WeeklyChallenge[]
  resultExaminations ResultExamination[]
  tests            Test[]
  readinessSubjects ReadinessSubject[]
}

model Class {
  id        String   @id @default(uuid())
  name      String // e.g. "MCA", "B.Tech CSE"
  code      String?
  batchYear String? // e.g. "2025" — nullable at the DB level (existing classes predate this field);
                     // required at the application layer for newly created classes
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId String?

  // Attendance Management's Department → Division hierarchy — nullable so every existing Class
  // row (and everything else that already reads Class: tests, learning, resume, etc.) keeps
  // working unchanged. A Class only becomes attendance-eligible once an admin assigns it into a
  // Division (see routes/attendance.js's admin division-assignment endpoint).
  division   Division? @relation(fields: [divisionId], references: [id])
  divisionId String?

  users           User[]
  testAssignments TestClass[]

  staffAssignments   StaffClassAssignment[]

  @@unique([instituteId, name, batchYear])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  rollNumber   String?  // students only — a.k.a. College/Institute ID
  registrationNumber String? // students only — separate from rollNumber, e.g. university enrollment no.
  department   String?
  mobile       String?
  gender       String?  // optional, free-text
  program      String?  // free-text fallback if no Class relation is set
  batchYear    String?
  section      String?
  isActive     Boolean  @default(true) // false = account is deactivated; blocked at login
  profilePhotoUrl String? // optional; stored as a data URL, no external file storage in use
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime? // drives per-institute password-expiry enforcement
  createdAt    DateTime @default(now())

  // Staff & Clerk Management Dashboard fields — see AccountStatus's own comment for how it relates
  // to isActive. employeeId/designation are admin-editable free text, mirroring `department`.
  accountStatus AccountStatus @default(ACTIVE)
  employeeId    String?
  designation   String?
  lastLoginAt   DateTime? // denormalized from LoginSession, written by createSession() — avoids a
                          // per-row join/subquery when listing/filtering/sorting thousands of
                          // accounts by last-login date.

  institute   Institute? @relation(fields: [instituteId], references: [id])
  instituteId String?
  class       Class?     @relation(fields: [classId], references: [id])
  classId     String?

  // Institute -> Batch -> Department -> Section: replaces Class/classId as the platform's real
  // enrollment/grouping mechanism. classId above is kept populated for existing rows (rollback
  // safety net) but is no longer read by any new code once the cutover phases ship.
  academicGroup   AcademicGroup? @relation(fields: [academicGroupId], references: [id])
  academicGroupId String?

  resetTokenHash   String?
  resetTokenExpiry DateTime?

  createdTests Test[]         @relation("TestCreator")
  attempts     TestAttempt[]
  submissions  Submission[]
  createdQuestions Question[]
  createdQuestionFolders QuestionFolder[]

  lessonProgress LessonProgress[]
  certificates    Certificate[]
  practiceRunLogs PracticeRunLog[]
  codeDrafts      CodeDraft[]
  moduleCodingAttempts ModuleCodingAttempt[]
  xpEvents        XpEvent[]
  badges          StudentBadge[]
  streak          StudentStreak?
  resume          Resume?
  resumeFeedback  ResumeFeedback[]
  studentProfile  StudentProfile?
  placementOffers PlacementOffer[]
  studentDocuments StudentDocument[]

  interviewSessions    InterviewSession[]
  interviewReports     InterviewReport[]
  interviewCertificate InterviewCertificate?
  emailLogs            EmailLog[]

  passwordHistory PasswordHistory[]
  loginSessions   LoginSession[]

  dailyChallengeSubmissions  DailyChallengeSubmission[]
  weeklyChallengeSubmissions WeeklyChallengeSubmission[]

  // Attendance Management — staff only: which classes this staff member has been assigned to
  // mark attendance for, and the plans/sessions/records that flow from that.
  staffClassAssignments    StaffClassAssignment[] @relation("StaffClassAssignments")
  lecturePlansCreated      LecturePlan[]          @relation("LecturePlanCreatedBy")
  attendanceSessionsMarked AttendanceSession[]    @relation("AttendanceMarkedBy")
  attendanceSessionsUpdated AttendanceSession[]   @relation("AttendanceUpdatedBy")
  attendanceRecords        AttendanceRecord[]     @relation("AttendanceStudentRecords")

  // Talent Pool module — arbitrary cross-department/batch student groupings, distinct from
  // AcademicGroup (see TalentPool's own doc comment for why that model can't be reused here).
  notifications          Notification[]
  talentPoolMemberships  TalentPoolMember[]
  createdTalentPools     TalentPool[]      @relation("TalentPoolCreator")

  // Manual/offline exam results (Result Management module) — never duplicates name/roll/
  // department here, always read live off this User + its academicGroup at render time.
  resultEntries ResultEntry[]

  // Employability & Subject Readiness Assessment module — see ReadinessSubject's own doc comment.
  createdReadinessSubjects ReadinessSubject[]
  readinessAssessments     ReadinessAssessment[]
  readinessReports         ReadinessReport[]

  @@index([instituteId])
  @@index([classId])
  @@index([academicGroupId])
  @@index([role])
  @@index([department])
  @@index([role, instituteId])
  @@index([accountStatus])
  @@index([rollNumber])
  // Registration Number (PRN) is the platform's sole permanent, system-wide unique student
  // identifier — global (not per-institute), NULL-tolerant (staff/admin rows, where it's always
  // null, never conflict with anything under standard Postgres unique-constraint semantics).
  // Roll Number (classroom number, used for attendance/display/sort ordering) is deliberately
  // NOT unique — duplicates across departments/institutes are expected and allowed by design, so
  // it carries a plain index (for WHERE/LIKE filtering) instead of a uniqueness constraint.
  @@unique([registrationNumber])
  // Same NULL-tolerant semantics as rollNumber above, for Staff/Clerk employee IDs.
  @@unique([instituteId, employeeId])
}

model Test {
  id           String   @id @default(uuid())
  title        String
  code         String?
  description  String?
  instructions String?
  durationMin  Int      @default(60)
  passingMarks Int?
  showResults  Boolean  @default(true)
  // Set only for a company-specific placement round (e.g. "TCS", "Amazon") — reuses this same
  // Test/TestTaking pipeline rather than a parallel one; null = a regular test, not company-tagged.
  company      String?
  startTime    DateTime
  endTime      DateTime
  isPublished  Boolean  @default(false)
  requireFullscreen Boolean @default(true)
  requireWebcam     Boolean @default(false) // best-effort face presence check, mirrors ModuleCodingTest
  requireMicrophone Boolean @default(false) // mic-drop is monitored/warned but never blocks Submit
  // Attendance Management integration: when true, this test only appears in the Attendance
  // module's Practice Test/Exam "Select Test" dropdown, and POST /:id/start blocks any student
  // who hasn't been marked Present for the lecture this test is linked to (see AttendanceSession).
  attendanceMandatory Boolean @default(false)
  shuffleQuestions  Boolean @default(true)  // each student gets a random per-attempt question order (same question set)
  shuffleOptions    Boolean @default(false) // each student also gets randomized MCQ/MULTISELECT option order
  // "FIXED" (default): every student gets the test's full configured question list (questions[]).
  // "RANDOM": every student gets a random randomQuestionsPerStudent-sized subset of the questions
  // in randomBankFolder, generated once at attempt start — see buildAttemptOrder() in tests.js.
  // In RANDOM mode, questions[] still holds every question in the bank (so admin edits/points/
  // time limits are managed the normal way); it's just never shown to a student in full.
  questionSelectionMode    String  @default("FIXED")
  randomBankFolder         QuestionFolder? @relation(fields: [randomBankFolderId], references: [id])
  randomBankFolderId       String?
  randomQuestionsPerStudent Int?
  difficultyDistribution   Json? // optional { easy, medium, hard } counts that must sum to randomQuestionsPerStudent
  createdBy    User     @relation("TestCreator", fields: [createdById], references: [id])
  createdById  String
  institute    Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId  String?    // null = platform-wide test, only ever set by a platform-level (instituteId-less) creator — mirrors QuestionFolder.instituteId. Gates the "empty group/class assignment = open to everyone" convention in testEligibility.js so an institute-scoped test can never leak across institutes.
  createdAt    DateTime @default(now())

  questions TestQuestion[]
  attempts  TestAttempt[]
  classes   TestClass[] // empty = open to all classes (legacy/unscoped tests)
  academicGroups TestAcademicGroup[] // replaces classes[] as the real eligibility gate — see testEligibility.js
  talentPools    TalentPoolTest[] // presence of any row makes this test Talent-Pool-exclusive — overrides, not OR's with, the academicGroups/classes check (see testEligibility.js)

  // Attendance Management: when Lecture Type = Exam, a session can link back to the Test being
  // administered, so exam attendance is tied to the actual test rather than duplicated.
  attendanceSessions AttendanceSession[]
  // Talent Pool attendance: the auto-generated LecturePlan (if any) that represents this Test for
  // a pool's attendance owner — see LecturePlan.testId.
  lecturePlans       LecturePlan[]

  @@index([createdById])
  @@index([isPublished])
  @@index([startTime, endTime])
  @@index([company])
  @@index([instituteId])
}

// Join table: which classes a test is assigned to — legacy, superseded by TestAcademicGroup below.
model TestClass {
  id      String @id @default(uuid())
  test    Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId  String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String

  @@unique([testId, classId])
  // The composite unique above is only efficient for lookups keyed off testId (its leading
  // column) — but GET /tests filters by classId across every test at once (one student loading
  // their test list), the opposite direction. Without this, that filter falls back to scanning
  // every TestClass row.
  @@index([classId])
}

// Join table: which academic groups (Institute+Batch+Department+Section) a test is assigned to.
// Empty = open to all groups (mirrors TestClass's "empty = open to all classes" convention).
model TestAcademicGroup {
  id              String        @id @default(uuid())
  test            Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId          String
  academicGroup   AcademicGroup @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  academicGroupId String

  @@unique([testId, academicGroupId])
  // Same reasoning as TestClass.classId below — the composite unique only helps testId-first
  // lookups. GET /tests, dashboard.js, and studentPerformance.js all now filter by a student's
  // own academicGroupId across every test in the platform (testEligibilityWhere), the direction
  // this index actually serves. This is the batch/section this whole eligibility check runs for
  // on every test-list load, exam start, and dashboard load — worth it at real scale.
  @@index([academicGroupId])
}

// ===================================================================
// Talent Pool module — admin-curated, arbitrary cross-department/batch
// groupings of students (e.g. "Elite Coders", "Placement Batch"). This is
// deliberately NOT built on AcademicGroup: AcademicGroup is strictly the
// auto-derived Institute->Batch->Department->Section hierarchy (one student,
// one group, upserted from registration data — see resolveAcademicGroup()
// in users.js), so it cannot represent a hand-picked set of students that
// crosses departments or batches. TalentPoolMember is a real many-to-many
// roster instead. Exclusive-assessment scoping mirrors the existing
// Test/TestAcademicGroup pattern (TalentPoolTest) plus a new, minimal
// Interview-side gate (TalentPoolInterviewConfig), since InterviewSession
// has no group-scoping concept today.
// ===================================================================

model TalentPool {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdBy   User     @relation("TalentPoolCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A pool can span multiple institutes (replaces the earlier single-instituteId design — no
  // live pools existed when this changed, so this was a clean replacement, not a migration).
  // Empty list = platform-level pool (unscoped Super Admin), same convention as the old nullable
  // instituteId used to express.
  institutes TalentPoolInstitute[]

  members          TalentPoolMember[]
  autoRule         TalentPoolAutoRule?
  testAssignments  TalentPoolTest[]
  interviewConfigs TalentPoolInterviewConfig[]
  attendanceOwners StaffClassAssignment[] @relation("TalentPoolAttendanceOwners")

  @@index([isActive])
}

// Join table for TalentPool's multi-institute membership. A pool is visible/manageable by an
// institute-scoped ADMIN/STAFF only when their institute appears here (see loadPoolScoped in
// routes/talentPools.js) — replaces the old exact-match check against a single instituteId.
model TalentPoolInstitute {
  id          String     @id @default(uuid())
  pool        TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolId      String
  institute   Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId String

  @@unique([poolId, instituteId])
  @@index([instituteId])
}

// The arbitrary M:N roster — the actual reason this feature needs a new model rather than reusing
// AcademicGroup. addedByName mirrors Certificate.revokedByName's non-FK audit-name convention
// (null when addedVia AUTO_RULE, since no admin personally added that row).
model TalentPoolMember {
  id          String     @id @default(uuid())
  pool        TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolId      String
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  addedVia    String     @default("MANUAL") // "MANUAL" | "AUTO_RULE"
  addedByName String?
  addedAt     DateTime   @default(now())

  @@unique([poolId, studentId])
  @@index([poolId])
  @@index([studentId])
}

// One optional auto-selection rule per pool. Re-running the rule only ever ADDS newly-matching
// students (see talentPoolAutoSelect.js) — it never removes existing members, since live metrics
// like attendance% must not silently evict someone the admin (or a prior run) already selected.
model TalentPoolAutoRule {
  id                            String   @id @default(uuid())
  pool                          TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolId                        String   @unique
  minCgpa                       Float?
  minAttendancePercent          Float?
  minAverageScorePercent        Float?
  minCompletionPercent          Float?   // Learning Module completion %
  // Employability & Readiness module criteria — evaluated against each candidate's BEST completed
  // ReadinessReport (optionally narrowed to one subject via readinessSubjectId; a null subject
  // considers a student's best report across every subject they've attempted). "Best" rather than
  // "latest" so one bad early attempt can't disqualify a student who has since improved — but per
  // the module's "never label talent from a single test" rule, this is still just one of
  // potentially several ALL/ANY criteria on the rule, not a standalone pass/fail.
  minReadinessScorePercent      Float?
  readinessLevelAtLeast         String?  // one of ReadinessReport.readinessLevel's 6 labels
  readinessSubjectId            String?
  requiredBadgeIds              Json?    // string[] of Badge.id
  requiredCertificateCourseIds  Json?    // string[] of Course.id, matched against VALID Certificate rows
  matchMode                     String   @default("ALL") // "ALL" | "ANY"
  scopeInstituteId              String?
  scopeDepartmentIds            Json?    // string[] of Department.id
  scopeBatch                    String?
  lastRunAt                     DateTime?
  lastRunAddedCount             Int?     @default(0)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

// Direct mirror of TestAcademicGroup, but the exclusivity direction is inverted from the
// "empty = open to everyone" convention: presence of ANY row here makes the test invisible to
// non-members (see testEligibility.js's memberPoolIds handling), since a pool-exclusive test must
// never fall back to being open-to-all just because it also happens to have zero group/class rows.
model TalentPoolTest {
  id             String   @id @default(uuid())
  pool           TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolId         String
  test           Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId         String
  assignedAt     DateTime @default(now())
  reminderSentAt DateTime? // idempotency flag for the opt-in deadline-reminder scheduler

  @@unique([poolId, testId])
  @@index([testId])
}

// The minimal Mock Interview exclusivity gate: InterviewSession has no group-scoping today, so
// rather than building a full parallel eligibility engine for it, a pool can define named
// interview configs (same config shape InterviewSession.config already uses) that only pool
// members may start a session against — see the talentPoolConfigId branch in interview.js's
// POST /sessions, sibling to the existing isMock/isCompanyRound branches.
model TalentPoolInterviewConfig {
  id        String   @id @default(uuid())
  pool      TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolId    String
  label     String
  isActive  Boolean  @default(true)
  config    Json     // {difficulty, company, mix, durationMin, ...} — same shape as InterviewSession.config
  createdAt DateTime @default(now())

  sessions InterviewSession[]

  @@index([poolId])
}

model Question {
  id             String       @id @default(uuid())
  questionNumber Int          @default(autoincrement()) @unique // human-friendly display ID, e.g. "Q102"
  title          String?      // question name (optional label)
  description    String       // question text
  subject        String?
  topic          String?
  // Employability & Subject Readiness module additions — all nullable/defaulted so every existing
  // question (and every existing Formal Test/Module Coding/Practice/Challenge/Interview query
  // against this table) is completely unaffected.
  subtopic       String?  // finer-grained than `topic`, optional
  btlLevel       Int?     // Bloom's Taxonomy level 1-6 (Remember..Create). Never inferred/assigned
                          // automatically — set explicitly at authoring/review time based on the
                          // question's actual cognitive task, not its wording. Null = not yet
                          // classified; such questions are excluded from Readiness blueprints but
                          // remain fully usable everywhere else on the platform (Tests, Practice, etc).
  skillTested    String?  // free-text, e.g. "Normalization", "Recursion"
  questionStatus QuestionStatus @default(PUBLISHED) // defaults PUBLISHED so every pre-existing
                          // question and everything created via the existing Create/Bulk-Import/
                          // AI-Generate flows keeps working unchanged; only the Readiness module's
                          // own authoring flow moves a question through DRAFT->UNDER_REVIEW->VERIFIED.
  aiGenerated    Boolean  @default(false)
  questionType   QuestionType @default(CODING)
  difficulty     Difficulty   @default(EASY)
  points         Int          @default(10) // marks
  explanation    String?
  createdAt      DateTime     @default(now())

  // CODING-only fields
  timeLimitMs   Int     @default(2000)
  memoryLimitKb Int?    // null = use the judge's global default (JUDGE_MEMORY_LIMIT_KB)
  starterCode   String? // legacy single-language fallback, kept for old questions/callers
  starterCodeByLanguage Json? // { java, python, cpp, c, javascript } — preferred when present
  tags          Json?   // string[], e.g. ["Arrays","Dynamic Programming"]

  // "Professional structure" fields (LeetCode/HackerRank-style problem statement) — all optional
  // so existing/legacy questions render fine with these simply omitted. problemExplanation is
  // distinct from the pre-existing `explanation` field above, which is a staff-only note never
  // shown to students (see CreateQuestion.jsx) — this one IS shown to students, as a beginner-
  // friendly walkthrough of the problem, so the two must never be conflated.
  estimatedTimeMin  Int?
  realWorldScenario String?
  constraints       String?
  inputFormat       String?
  outputFormat      String?
  notes             String?
  edgeCases         String?
  problemExplanation String?

  // Editorial/hints block (CODING only) — deliberately excluded from the sanitizer used for
  // proctored Formal Tests and Module Coding Assessments (same treatment as hidden test cases),
  // so these only ever reach students in self-paced contexts (Practice, Interview Prep, Daily/
  // Weekly Challenge). ProblemStatement.jsx renders each section only when present, so omitting
  // them from a proctored payload is sufficient gating — no extra frontend logic needed.
  hints            Json?   // string[] — progressive hints, revealed one at a time by the student
  timeComplexity   String? // e.g. "O(n)"
  spaceComplexity  String? // e.g. "O(1)"
  editorial        Json?   // { bruteForce: {approach, complexity}, betterApproach: {...}, optimal: {...} }
  similarQuestions Json?   // string[] of related question titles — plain text, not a hard relation (spans multiple models)

  // "STDIO" (default): the student's submitted code IS the whole program — reads stdin, writes
  // stdout, same as it always has been. "FUNCTION": LeetCode-style — the student writes only a
  // method/function body matching functionSignature; the judge auto-generates the surrounding
  // driver (stdin parsing, method invocation, output formatting) at judge time — see
  // backend/src/utils/functionHarness.js. Only meaningful for CODING questions.
  evaluationType   String @default("STDIO")
  functionSignature Json? // { methodName, returnType, params: [{name, type}] } — see functionHarness.js SUPPORTED_TYPES

  // MCQ / TRUE_FALSE / MULTISELECT fields
  options       Json? // array of option strings
  correctAnswer Json? // array of correct option indices

  // SQL-only: DDL + seed data (CREATE TABLE ...; INSERT INTO ...;) run once against a fresh
  // in-memory SQLite database before each test case, shared across all of this question's cases.
  // A case's own TestCase.input is optional *additional* setup SQL run after this (e.g. extra
  // rows for that specific case — the LeetCode-SQL-problem pattern of varying the underlying
  // data per case while grading the same submitted query); TestCase.expected holds the
  // serialized expected result set. SQLite dialect only — see utils/sqlJudge.js.
  sqlSchema String?

  testCases TestCase[]
  testLinks TestQuestion[]
  dailyChallenges  DailyChallenge[]
  weeklyChallenges WeeklyChallenge[]
  readinessAnswers ReadinessAnswer[]

  // Set only when this question belongs to a Learning Module's proctored coding-test pool
  // (reusing this same Question/TestCase model — hidden test cases, judge grading — rather
  // than a separate coding_questions table, exactly like the exam side already does).
  moduleCodingTest   ModuleCodingTest? @relation(fields: [moduleCodingTestId], references: [id], onDelete: Cascade)
  moduleCodingTestId String?
  moduleAttemptLinks ModuleCodingAttemptQuestion[]

  // Institute-private question banks. Nullable, and deliberately NOT backfilled on migration —
  // every question created before this feature stays instituteId: null, which the visibility
  // rule (see questions.js's instituteVisibilityWhere) treats as "shared legacy bank, visible to
  // every institute" rather than "belongs to nobody." That's what keeps existing question banks
  // from silently disappearing for every institute's staff the moment this ships. Only questions
  // created going forward get scoped to their creator's institute and become genuinely private.
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  instituteId String?
  folder      QuestionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String? // nullable — questions created before this field existed have no recorded author

  @@index([subject])
  @@index([topic])
  @@index([questionType])
  @@index([moduleCodingTestId])
  @@index([instituteId])
  @@index([folderId])
  @@index([createdById])
  @@index([btlLevel])
  @@index([questionStatus])
}

// A named grouping within an institute's question bank (e.g. "Java", "DBMS Midterm"), nestable
// (parent/children) so banks can be organized like "Fox Solutions > Aptitude > Percentages."
// Deletion requires the folder to be empty of both questions and child folders (see the DELETE
// route) — the previous "un-file on delete" behavior is replaced by an explicit block, per spec:
// admins move/merge first, then delete.
model QuestionFolder {
  id          String   @id @default(uuid())
  name        String
  category    String?  // free-text grouping label (e.g. "Aptitude", "Technical") shown alongside the name
  description String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId String?    // null = platform-level folder, visible to every institute (Super Admin created)
  parent      QuestionFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String?
  children    QuestionFolder[] @relation("FolderHierarchy")
  createdAt   DateTime @default(now())

  // Staff-private Question Bank workspaces. Nullable and NOT backfilled, same reasoning as
  // Question.createdById above it — every folder created before this field existed stays
  // createdById: null, which questionVisibility.js's questionVisibilityWhere treats as shared/
  // legacy (visible+editable by any institute staff) rather than "belongs to nobody," so no
  // pre-existing folder tree disappears the moment this ships. Only folders created going
  // forward become genuinely private to the staff member who made them.
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  questions Question[]
  randomBankTests Test[]

  @@index([parentId])
  @@index([instituteId])
  @@index([createdById])
}

model TestCase {
  id          String   @id @default(uuid())
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  input       String
  expected    String
  isHidden    Boolean  @default(true) // hidden test cases aren't shown to students
  explanation String?  // optional, sample cases only — shown alongside the case to help students understand it
}

// Join table: which questions belong to which test, in what order
model TestQuestion {
  id         String   @id @default(uuid())
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId     String
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  order      Int      @default(0)
  timeLimitSec Int    @default(900) // how long the student gets on this question within the test

  @@unique([testId, questionId])
}

model TestAttempt {
  id          String    @id @default(uuid())
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId      String
  student     User      @relation(fields: [studentId], references: [id])
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  totalScore  Int       @default(0)
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, AUTO_SUBMITTED
  tabSwitchCount Int    @default(0)

  // Generated once, at first attempt creation, from Test.shuffleQuestions/shuffleOptions — never
  // recomputed afterward, so a refresh, logout/login, or auto-save/recovery always sees the same
  // sequence. questionOrder: Question.id[] in this student's display order (equals the test's
  // configured order when shuffleQuestions is off). optionOrder: { [questionId]: number[] }, a
  // permutation of original option indices per MCQ/MULTISELECT/TRUE_FALSE question — populated
  // only when shuffleOptions is on.
  questionOrder Json?
  optionOrder   Json?

  submissions Submission[]

  @@unique([testId, studentId])
  @@index([testId])
}

model Submission {
  id           String      @id @default(uuid())
  attempt      TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId    String
  questionId   String
  student      User        @relation(fields: [studentId], references: [id])
  studentId    String
  language     String
  code         String
  score        Int         @default(0)
  passedCases  Int         @default(0)
  totalCases   Int         @default(0)
  verdict      String      @default("PENDING") // ACCEPTED, PARTIAL, WRONG_ANSWER, TLE, RUNTIME_ERROR, COMPILE_ERROR, PENDING
  timeMs       Int? // max execution time across judged test cases (coding only)
  memoryKb     Int? // max memory usage across judged test cases (coding only)
  createdAt    DateTime    @default(now())

  // One row per attempt+question — enforced at the DB level so autosave's upsert can never
  // race into two rows for the same question (which previously risked the grader picking the
  // wrong one). MCQ/TRUE_FALSE/MULTISELECT still get a fresh row per answer-change via
  // deleteMany+create, which also respects this constraint (at most one row survives).
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([studentId])
}

// Lightweight audit trail for sensitive admin actions (currently just reattempt grants).
model AuditLog {
  id          String   @id @default(uuid())
  action      String // e.g. "REATTEMPT_GRANTED", "LOGIN", "LOGOUT", "CERTIFICATE_ISSUED" — see
  // AUDIT_ACTIONS in utils/auditLog.js for the full catalogue this platform writes.
  adminId     String
  adminName   String
  adminRole   String? // denormalized at write time — Role enum value, nullable so pre-existing rows stay valid
  ipAddress   String?
  deviceInfo  String? // short summary, e.g. "Chrome on Windows" — parsed from User-Agent, not stored raw
  studentId   String? // the account acted on, when applicable — lets history views filter per-student
  instituteId String? // denormalized at write time from the acted-on student, so Staff can query
  // their own institute's history directly instead of joining through User for every row
  details     Json
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([studentId])
  @@index([instituteId])
  @@index([createdAt])
}

model PasswordHistory {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
}

// One row per login, kept through logout/expiry (isActive flips to false rather than the row
// being deleted) so "recent login history" stays queryable, not just the currently-active set.
model LoginSession {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique // the JWT's jti — lets a revoked session's token be rejected server-side
  ip        String?
  device    String?   // "Mobile" | "Tablet" | "Desktop", parsed from User-Agent
  browser   String?
  os        String?
  isActive  Boolean   @default(true)
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?

  @@index([userId])
  @@index([userId, isActive])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

// One row per outbound transactional email (welcome/password-reset), so admins can see actual
// delivery status per student instead of trusting a fire-and-forget send. Written by
// utils/mailer.js's sendMailLogged() helper — never inferred from "the API call didn't throw".
model EmailLog {
  id              String      @id @default(uuid())
  student         User?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId       String?
  recipientName   String
  recipientEmail  String
  emailType       String // "WELCOME" | "PASSWORD_RESET"
  status          EmailStatus @default(PENDING)
  errorMessage    String?
  messageId       String?
  retryCount      Int         @default(0)
  createdAt       DateTime    @default(now())
  sentAt          DateTime?

  @@index([status])
  @@index([studentId])
  @@index([createdAt])
}

// Persisted in-app notification — did not exist anywhere on the platform before the Talent Pool
// module (the dashboard bell was previously a student-only, live-computed list with no backing
// table — see getNotifications() in dashboard.js and the comment in Navbar.jsx). `type` is a
// plain extensible String tag, not an enum, matching EmailLog.emailType's convention. Every write
// here is paired with a sendMailLogged() call for the email channel — see utils/notifications.js.
model Notification {
  id          String    @id @default(uuid())
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  type        String    // e.g. "TALENT_POOL_ADDED" | "TALENT_POOL_REMOVED" | "TALENT_POOL_ASSESSMENT_ASSIGNED" | "TALENT_POOL_DEADLINE_REMINDER" | "TALENT_POOL_RESULTS_PUBLISHED"
  message     String
  link        String?
  read        Boolean   @default(false)
  readAt      DateTime?
  meta        Json?
  createdAt   DateTime  @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

// ===================================================================
// Learning Module (LMS) — self-paced course content, separate from the
// exam/TestAttempt world above. A Course (e.g. "java") holds ordered
// CourseModules, each holding ordered Lessons, each optionally holding
// ordered PracticeQuestions. Deliberately its own model family (not
// reusing Test/Question) since practice here has different semantics:
// untimed, unlimited retries, immediate feedback, no proctoring.
// ===================================================================

model Course {
  id          String   @id @default(uuid())
  slug        String   @unique // "java", "python", ...
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(false) // false = shown as "Coming soon", not browsable — kept in
  // sync with `status === PUBLISHED` on every write, for backward compat with any read site that
  // still checks isActive directly rather than status.
  createdAt   DateTime @default(now())

  // --- lifecycle & metadata (additive) ---
  status               CourseStatus @default(DRAFT)
  category             String?
  thumbnailUrl         String?  // external URL only — no object storage on this platform, same
                                 // convention as Lesson.videoUrl/pdfUrl and Resume.photoUrl
  bannerUrl            String?  // external URL only, same convention
  instructorName       String?
  skillsCovered        Json?    // string[] — e.g. ["OOP", "Collections", "Multithreading"]
  estimatedDurationMin Int?
  difficulty           Difficulty?

  modules      CourseModule[]
  certificates Certificate[]

  instituteAssignments     CourseInstituteAssignment[]
  academicGroupAssignments CourseAcademicGroupAssignment[]
  prerequisites CoursePrerequisite[] @relation("CoursePrerequisites")  // this course's prerequisites
  requiredFor   CoursePrerequisite[] @relation("CoursePrerequisiteOf") // courses that require this one

  @@index([status])
  @@index([category])
}

// Explicit join table (not an implicit Prisma m2m self-relation — this schema has no precedent
// for implicit m2m, only explicit join tables like TestAcademicGroup) recording which Courses
// must be completed (hold a LEARNING_MODULE certificate) before a given Course unlocks.
model CoursePrerequisite {
  id                   String   @id @default(uuid())
  course               Course   @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  courseId             String
  prerequisite         Course   @relation("CoursePrerequisiteOf", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)
  prerequisiteCourseId String
  createdAt            DateTime @default(now())

  @@unique([courseId, prerequisiteCourseId])
  @@index([courseId])
  @@index([prerequisiteCourseId])
}

// Broad grant: Course visible to every student in this Institute (every current+future
// AcademicGroup under it) — mirrors the "assign X to specific groups" pattern already proven by
// TestAcademicGroup, except INVERTED: a Course with zero rows across both assignment tables is
// invisible to students (see courseEligibility.js), not open-to-all like TestAcademicGroup's
// "empty = open" convention. Only a PUBLISHED course may receive a new row (enforced at the
// route). Archiving a course leaves these rows in place so a re-published course regains
// visibility instantly without re-assignment.
model CourseInstituteAssignment {
  id               String    @id @default(uuid())
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  institute        Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId      String
  assignedByUserId String
  assignedByName   String
  createdAt        DateTime  @default(now())

  @@unique([courseId, instituteId])
  @@index([courseId])
  @@index([instituteId])
}

// Fine-grained grant: Course visible only to this specific AcademicGroup (Institute+Batch+
// Department+Section), independent of any CourseInstituteAssignment row for the same course.
model CourseAcademicGroupAssignment {
  id               String        @id @default(uuid())
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  academicGroup    AcademicGroup @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  academicGroupId  String
  assignedByUserId String
  assignedByName   String
  createdAt        DateTime      @default(now())

  @@unique([courseId, academicGroupId])
  @@index([courseId])
  @@index([academicGroupId])
}

model CourseModule {
  id          String   @id @default(uuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  lessons Lesson[]
  codingTest ModuleCodingTest?
  chapters   Chapter[]

  @@unique([courseId, title])
  @@index([courseId])
}

// A Chapter groups a Module's "Learn" content (Lessons acting as Learning Topics) together
// with the Coding Assessment Level(s) that gate progression past it. Additive on top of the
// pre-existing flat Course->Module->Lesson tree: every pre-Chapter Module gets backfilled with
// one "General" Chapter (see backend/scripts/backfillChapters.js) so nothing existing changes
// behavior, while new content can be organized into multiple named Chapters per Module.
model Chapter {
  id                      String   @id @default(uuid())
  module                  CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId                String
  title                   String
  description             String?
  order                   Int      @default(0)
  isActive                Boolean  @default(true)
  // Whether this Chapter's Levels are required for the course-wide CODING_ASSESSMENT
  // certificate (see gradeModuleCodingAttempt.js / gatingLevels.js) — lets an admin mark a
  // Chapter as optional/bonus without it blocking certificate issuance. Does NOT affect module
  // unlock progression, which always requires all active Levels regardless of this flag.
  countsTowardCertificate Boolean  @default(true)
  createdAt               DateTime @default(now())

  topics Lesson[]
  levels ModuleCodingTest[]

  @@unique([moduleId, title])
  @@index([moduleId])
}

model Lesson {
  id               String   @id @default(uuid())
  module           CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId         String
  chapter          Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId        String?
  title            String
  order            Int      @default(0)
  content          String?  // admin-authored HTML: explanation, examples, syntax, notes, best practices
  // Ordered array of typed blocks ({type:"text"|"youtube"|"image"|"table"|"code"|"note"|"file"|"quiz", ...})
  // for chapter-scoped Learning Topics. When present, the frontend renders this instead of
  // `content`; when null/empty it falls back to the legacy single-HTML-string `content` render,
  // so pre-existing lessons need no data migration.
  blocks           Json?
  videoUrl         String?  // external link (e.g. YouTube) — no in-house video hosting
  pdfUrl           String?  // external link to a hosted PDF — no in-house file storage
  externalLinks    Json?    // [{ label, url }]
  estimatedMinutes Int      @default(10)
  isActive         Boolean  @default(true)
  // The gating practice test for its module — batch-submitted (not per-question), scored,
  // and required to pass before the next module unlocks. At most one per module in practice
  // (the last lesson), but not DB-enforced since nothing breaks if that changes.
  isModuleTest     Boolean  @default(false)
  createdAt        DateTime @default(now())

  progress  LessonProgress[]
  questions PracticeQuestion[]

  @@unique([moduleId, title])
  @@index([moduleId])
  @@index([chapterId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  bookmarked  Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId])
}

// type: MCQ, FILL_BLANK, CODING, DEBUG, OUTPUT_PREDICTION — DEBUG/OUTPUT_PREDICTION are
// graded the same way as MCQ (pick the right option from `options`), the distinct type is
// only used to vary the UI label/icon. FILL_BLANK is graded by trimmed case-insensitive
// string match against `correctAnswer`. CODING reuses the exam judge against `testCases`.
model PracticeQuestion {
  id            String   @id @default(uuid())
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      String
  type          String
  title         String? // problem title, e.g. "Two Sum" — added for parity with Question, optional so existing rows (prompt-only) keep working
  prompt        String
  options       Json?
  correctAnswer Json?
  explanation   String?
  starterCode   String?
  starterCodeByLanguage Json? // { java, python, cpp, c, javascript } — preferred when present, same as Question
  testCases     Json? // CODING: [{input, expected, isHidden?}] — isHidden absent/false = sample case
  language      String?
  difficulty    Difficulty @default(EASY) // CODING only — drives the tiered solve-XP amount
  tags          Json?   // string[] — parity with Question.tags

  // LeetCode-style function-only submissions — same STDIO/FUNCTION split as Question, see
  // functionHarness.js. STDIO (default): student's code is the whole program. FUNCTION: student
  // writes only the method body matching functionSignature; judge.js auto-generates the driver.
  evaluationType    String @default("STDIO")
  functionSignature Json?

  // "Professional structure" fields — see the identically-named block on Question above for the
  // full rationale; kept in sync field-for-field so ProblemStatement.jsx can render either shape.
  estimatedTimeMin   Int?
  realWorldScenario  String?
  constraints        String?
  inputFormat        String?
  outputFormat       String?
  notes              String?
  edgeCases          String?
  problemExplanation String?

  // Editorial/hints block — see the identically-named block on Question above for the full
  // rationale; kept in sync field-for-field.
  hints            Json?
  timeComplexity   String?
  spaceComplexity  String?
  editorial        Json?
  similarQuestions Json?

  order         Int      @default(0)
  createdAt     DateTime @default(now())

  runLogs PracticeRunLog[]

  @@index([lessonId])
}

// One row per "Submit" click on a coding practice question (POST /learning/practice/:id/submit)
// — the only persisted trace of daily learning-module coding activity. "Run" (sample-case-only
// self-check) is deliberately not logged here, matching the Run/Submit split used everywhere else
// on the platform: Run is a free, unlimited, side-effect-free debugging aid, Submit is the real
// attempt. Powers the dashboard's coding-practice streak: any day with at least one row counts,
// regardless of verdict, since a streak should reward showing up and practicing, not just
// getting it right on the first try.
model PracticeRunLog {
  id         String   @id @default(uuid())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  question   PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  verdict    String
  createdAt  DateTime @default(now())

  @@index([studentId, createdAt])
}

// Generic code-draft autosave for coding surfaces that have no natural "attempt" row to hang a
// draft off of (Practice Coding, Mock Interview coding questions) — Coding Tests and Module
// Coding Tests autosave onto their own Submission/attempt models instead and don't use this.
// contextType + contextId together identify what's being edited (e.g. "PRACTICE" + questionId,
// or "INTERVIEW" + "<sessionId>:<questionId>") without needing a dedicated FK per surface.
model CodeDraft {
  id          String   @id @default(uuid())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  contextType String
  contextId   String
  code        String
  language    String
  updatedAt   DateTime @updatedAt

  @@unique([studentId, contextType, contextId])
}

enum CertificateType {
  LEARNING_MODULE
  CODING_ASSESSMENT
  MANUAL
  READINESS
}

enum CertificateStatus {
  VALID
  REVOKED
}

// Unified certificate record covering Learning Module completion, passed Coding Assessments
// (Module Coding Tests), and manually-issued institute certificates (workshops/FDP/bootcamps/
// placement prep/etc, which have no underlying enrollment model on this platform — an admin or
// staff member fills in the program name by hand at issuance time). AI Mock Interview
// certificates stay on the separate InterviewCertificate model below (already has its own
// working QR/verify flow) — the student-facing "My Certificates" page reads both tables and
// presents them as one list rather than migrating working data into this one.
model Certificate {
  id              String            @id @default(uuid())
  certificateCode String            @unique // format: CA-<year>-<institute code>-<program code>-<sequence>
  type            CertificateType   @default(LEARNING_MODULE)
  // Restrict, not Cascade: a certificate is proof the student earned something real (already
  // possibly shared/verified outside the app via its QR/verify link) — deleting the student or
  // course it's attached to must not silently destroy it. The corresponding delete routes
  // (users.js account-delete, learning.js course-delete) check for and report existing
  // certificates before deleting, the same way Test.createdBy already protects created tests.
  student         User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId       String
  course          Course?           @relation(fields: [courseId], references: [id], onDelete: Restrict) // LEARNING_MODULE only
  courseId        String?
  moduleCodingTestId String?        // CODING_ASSESSMENT only — denormalized, no FK (see AuditLog.adminId for the same pattern)
  readinessSubjectId String?        // READINESS only — denormalized, no FK, same convention as moduleCodingTestId
  readinessLevel     String?        // READINESS only — the ReadinessReport.readinessLevel that qualified, for display
  title           String            // display name on the certificate PDF, populated for every type
  programName     String?           // MANUAL only — free text, e.g. "FDP: Advanced Java Workshop"
  status          CertificateStatus @default(VALID)
  revokedAt       DateTime?
  revokedByName   String?
  revokedReason   String?
  issuedByName    String?           // MANUAL only — which staff/admin issued it; null = system-issued
  issuedAt        DateTime          @default(now())

  // Includes `type` so a student can hold both a LEARNING_MODULE certificate (all lessons done)
  // and a CODING_ASSESSMENT certificate (all module coding tests passed) for the SAME course —
  // these are two independently-earned achievements, not one row per course.
  @@unique([studentId, courseId, type])
  // Separate uniqueness key for READINESS certs (one per student per subject) — courseId stays
  // null for this type, so it can't discriminate between subjects the way it discriminates
  // between courses for LEARNING_MODULE/CODING_ASSESSMENT.
  @@unique([studentId, readinessSubjectId, type])
  @@index([studentId])
  @@index([courseId])
  @@index([type])
  @@index([status])
}

// ===================================================================
// Mandatory Proctored Coding Test — gates progression between Learning
// Module modules. The spec names 8 tables (module_coding_tests,
// coding_questions, coding_submissions, coding_results, module_unlocks,
// proctoring_logs, webcam_snapshots, assessment_attempts), consolidated
// here into 6:
//   - coding_questions -> reuses Question/TestCase (adds a nullable
//     moduleCodingTestId), exactly like the exam side's hidden/public
//     test cases and judge grading — no separate question model needed.
//   - coding_results -> folded into ModuleCodingAttempt (score/passed
//     fields) rather than a separate 1:1 results table.
//   - module_unlocks -> NOT a table. Unlock state is computed on read by
//     getModuleLockMap (extended to also require a PASSED attempt when a
//     module has an active coding test configured), the same pattern
//     already used for lesson-completion-based locking — no cron, no
//     stale cache, no persisted state to keep in sync.
//   - webcam_snapshots -> NOT implemented. This platform has no object
//     storage (see Resume.photoUrl / Lesson.videoUrl comments); capturing
//     and storing periodic images isn't feasible here. Face-presence
//     detection (missing/multiple faces) is still implemented and logged
//     as a ProctoringViolation *event*, reusing the same blazeface
//     approach as the exam proctoring — it just never persists an image.
// A module with no ModuleCodingTest (or an inactive one) is ungated by
// this feature entirely — existing modules keep working exactly as
// before (lesson-completion locking only), so this is opt-in per module.
// ===================================================================

model ModuleCodingTest {
  id                 String   @id @default(uuid())
  // Legacy path: one test directly on a Module (moduleId set, chapterId null). New path: a
  // "Level" scoped to a Chapter (chapterId set, moduleId null) — a Chapter can have many
  // Levels. moduleId stays @unique so at most one legacy test can exist per Module; Postgres
  // treats NULL as distinct from every other NULL, so this constraint is a no-op for
  // chapter-scoped rows.
  module             CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId           String?  @unique
  chapter            Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId          String?
  order              Int      @default(0)
  title              String   @default("Module Coding Assessment")
  instructions       String?
  allowedLanguages   Json     @default("[\"java\",\"python\",\"javascript\",\"c\",\"cpp\"]") // string[]
  questionCount      Int      @default(3) // how many questions are drawn from the pool per attempt
  randomizeQuestions Boolean  @default(true) // false = always the pool's first N by `order`, in order
  passingPercent     Int      @default(70)
  timeLimitMin       Int      @default(45)
  maxAttempts        Int?     // null = unlimited
  cooldownMinutes    Int      @default(0) // required wait after a failed attempt before retrying
  maxViolations      Int      @default(3) // proctoring violations before auto-submit
  requireFullscreen  Boolean  @default(true)
  requireWebcam      Boolean  @default(false) // best-effort face presence check, see note above
  requireMicrophone  Boolean  @default(false) // mirrors requireWebcam — mic-drop is monitored/warned but never blocks final Submit
  allowResume        Boolean  @default(true) // resume an IN_PROGRESS attempt after a browser crash/refresh
  isActive           Boolean  @default(true) // false = gate is skipped entirely, module ungated
  createdAt          DateTime @default(now())

  questions Question[]
  attempts  ModuleCodingAttempt[]

  @@index([chapterId])
}

model ModuleCodingAttempt {
  id                 String   @id @default(uuid())
  moduleCodingTest   ModuleCodingTest @relation(fields: [moduleCodingTestId], references: [id], onDelete: Cascade)
  moduleCodingTestId String
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId          String
  attemptNumber      Int
  status             String   @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, AUTO_SUBMITTED
  score              Int      @default(0) // 0-100 percent across the attempt's questions
  passed             Boolean  @default(false)
  violationCount     Int      @default(0)
  autoSubmitReason   String?  // e.g. "MAX_VIOLATIONS", "TIME_EXPIRED"
  startedAt          DateTime @default(now())
  submittedAt        DateTime?

  questions   ModuleCodingAttemptQuestion[]
  submissions ModuleCodingSubmission[]
  violations  ProctoringViolation[]

  @@index([moduleCodingTestId, studentId])
  @@index([studentId])
}

// Snapshot of which questions (and in what order) were drawn for this specific attempt — so a
// resumed attempt sees the same set it started with, regardless of later pool changes/randomization.
model ModuleCodingAttemptQuestion {
  id         String   @id @default(uuid())
  attempt    ModuleCodingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  order      Int      @default(0)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// Mirrors Submission (exam side) but scoped to a ModuleCodingAttempt instead of a TestAttempt —
// kept as a sibling model rather than widening Submission's required attemptId FK, so this
// feature can't regress the exam submission flow at all.
model ModuleCodingSubmission {
  id          String   @id @default(uuid())
  attempt     ModuleCodingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId   String
  questionId  String
  studentId   String
  language    String
  code        String
  score       Int      @default(0)
  passedCases Int      @default(0)
  totalCases  Int      @default(0)
  verdict     String   @default("PENDING") // ACCEPTED, PARTIAL, WRONG_ANSWER, TLE, RUNTIME_ERROR, COMPILE_ERROR, PENDING
  timeMs      Int? // max execution time across judged test cases
  memoryKb    Int? // max memory usage across judged test cases
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One row per attempt+question — same race-proofing as Submission above; autosave's upsert
  // relies on this so two near-simultaneous saves for the same question can never create
  // duplicate rows that the grader might then pick between arbitrarily.
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// Event-level proctoring log (unlike the exam side's single tabSwitchCount integer) — an admin
// can review exactly what happened and when, not just how many times.
model ProctoringViolation {
  id        String   @id @default(uuid())
  attempt   ModuleCodingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId String
  type      String // TAB_SWITCH, FULLSCREEN_EXIT, COPY, PASTE, CUT, RIGHT_CLICK, DRAG_ATTEMPT, DEVTOOLS, REFRESH_ATTEMPT, MULTI_MONITOR, FACE_MISSING, MULTIPLE_FACES, CAMERA_DROPPED
  createdAt DateTime @default(now())

  @@index([attemptId, createdAt])
}

// ===================================================================
// Gamification — XP, levels, badges, streaks, leaderboards. Gamification
// starts counting from when this system was deployed; it does not
// retroactively backfill XP/badges for activity that already happened.
// ===================================================================

// Admin-configurable XP amount per activity — application code looks up
// the amount here rather than hardcoding it, so "Configure XP values" in
// the admin panel actually takes effect.
model XpRule {
  activity String @id // e.g. "MODULE_COMPLETE", "MODULE_QUIZ_PASS", "CODING_EASY", "TEST_COMPLETE", "DAILY_STREAK"
  label    String
  xp       Int
}

// One row per XP award — an append-only ledger. Total XP is SUM(xp); this
// doubles as the "Achievement History" list (activity + date + XP awarded).
model XpEvent {
  id        String   @id @default(uuid())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  activity  String
  label     String
  xp        Int
  meta      Json?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// Badge catalog — admin-manageable (create custom badges, enable/disable). `code` drives the
// auto-award criteria in utils/gamification.js; category groups them for the Achievements page.
model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  icon        String?
  category    String // LEARNING, CODING, ASSESSMENT, CONSISTENCY, SPECIAL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  earnedBy StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(uuid())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  // Restrict, not Cascade: deleting a Badge definition must not silently erase every student's
  // already-earned record of it — gamification.js's badge-delete route checks for and reports
  // existing StudentBadge rows first.
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  badgeId   String
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeId])
  @@index([studentId])
}

// One row per student. currentStreak/longestStreak are updated lazily — only when a
// streak-eligible activity happens (solving a coding problem or completing a lesson) — not on
// a schedule. Read paths must treat currentStreak as stale (effectively 0) once lastActiveDate
// is more than a day behind "today", since nothing proactively resets it on missed days.
model StudentStreak {
  studentId      String   @id
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime?
  updatedAt      DateTime @updatedAt
}

// ===================================================================
// Daily/Weekly Challenge — a LeetCode-style "problem of the day/week", drawn from the existing
// Question bank (admin schedules an existing Question onto a date, no separate authoring
// surface). Solving one routes through the same gamification hook (processGamification) and
// StudentStreak used everywhere else, so it counts toward the student's existing streak — no
// parallel streak system.
// Scope fields both nullable, following the same null-means-wider-scope convention as
// attachRequesterInstitute/req.requesterInstituteId used everywhere else in this codebase:
// instituteId=null,academicGroupId=null = Global; instituteId set,academicGroupId=null =
// institute-wide; both set = one academic group only. A student resolves "today's challenge" by
// most-specific-match (see utils/challengeScoping.js) — exactly one row applies to any student.
// The plain @@unique below cannot by itself stop two different Global rows for the same date
// (Postgres treats NULL as distinct in a composite unique), so the migration also adds two
// partial unique indexes — see the migration SQL for daily_challenge_global_unique /
// daily_challenge_institute_unique.
model DailyChallenge {
  id              String        @id @default(uuid())
  date            DateTime      // truncated to the day — no longer @unique alone, see scope note above
  question        Question      @relation(fields: [questionId], references: [id])
  questionId      String
  institute       Institute?    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId     String?
  academicGroup   AcademicGroup? @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  academicGroupId String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  submissions DailyChallengeSubmission[]

  @@unique([date, instituteId, academicGroupId])
  @@index([questionId])
  @@index([date])
}

model DailyChallengeSubmission {
  id               String         @id @default(uuid())
  dailyChallenge   DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)
  dailyChallengeId String
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId        String
  language         String
  code             String
  verdict          String   @default("PENDING")
  passedCases      Int      @default(0)
  totalCases       Int      @default(0)
  timeMs           Int?
  memoryKb         Int?
  solvedAt         DateTime? // set only once verdict becomes ACCEPTED — drives the streak/history checkmark
  updatedAt        DateTime @updatedAt

  @@unique([dailyChallengeId, studentId])
  @@index([studentId])
}

// Same scope-field convention as DailyChallenge above — see that model's comment.
model WeeklyChallenge {
  id              String        @id @default(uuid())
  weekStart       DateTime      // Monday of the ISO week this challenge belongs to
  question        Question      @relation(fields: [questionId], references: [id])
  questionId      String
  institute       Institute?    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId     String?
  academicGroup   AcademicGroup? @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  academicGroupId String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  submissions WeeklyChallengeSubmission[]

  @@unique([weekStart, instituteId, academicGroupId])
  @@index([questionId])
  @@index([weekStart])
}

model WeeklyChallengeSubmission {
  id                String          @id @default(uuid())
  weeklyChallenge   WeeklyChallenge @relation(fields: [weeklyChallengeId], references: [id], onDelete: Cascade)
  weeklyChallengeId String
  student           User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         String
  language          String
  code              String
  verdict           String   @default("PENDING")
  passedCases       Int      @default(0)
  totalCases        Int      @default(0)
  timeMs            Int?
  memoryKb          Int?
  solvedAt          DateTime?
  updatedAt         DateTime @updatedAt

  @@unique([weeklyChallengeId, studentId])
  @@index([studentId])
}

// ===================================================================
// Resume Builder — one resume per student. The repeating sub-sections
// (education, skills, projects, experience, certifications, achievements,
// languages) are stored as JSON arrays rather than separate join tables:
// they have no identity or use outside their parent resume, are always
// read/written as a whole section, and this keeps "save the whole resume
// in one PATCH" simple instead of needing 7 sets of CRUD endpoints.
// ===================================================================

model Resume {
  id        String @id @default(uuid())
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String @unique

  template String @default("modern") // modern | professional | minimal | classic | software-engineer | fresher | experienced
  targetRole String? // e.g. "Java Developer" — drives role-specific keyword-gap analysis

  fullName String?
  photoUrl String? // external image URL — no in-house file storage, same constraint as Learning Module videos/PDFs
  email    String?
  mobile   String?
  linkedin String?
  github   String?
  portfolio String?
  address  String?
  summary  String?

  education      Json? // [{ degree, specialization, institution, board, startYear, endYear, score, status }]
  skills         Json? // [{ category, name, proficiency, order }]
  projects       Json? // [{ title, description, technologies, role, duration, githubUrl, liveUrl }]
  experience     Json? // [{ company, title, employmentType, startDate, endDate, responsibilities, technologies }]
  certifications Json? // [{ name, org, issueDate, expiryDate, credentialId, credentialUrl }]
  achievements   Json? // [{ category, text }]
  languages      Json? // [{ name, proficiency }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ResumeVersion[]
}

// Version history — a full snapshot of every resume field plus the ATS score at that moment,
// captured automatically on every PATCH /resume/me save (not per-keystroke; each save already
// represents one section/field-group commit in the existing editor UX). Capped at the 20 most
// recent per resume (oldest pruned on insert) to keep storage bounded — "every major edit" is
// satisfied without unbounded growth from years of iterative tweaking.
model ResumeVersion {
  id        String   @id @default(uuid())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId  String
  snapshot  Json     // full copy of the resume's fields at this point in time
  atsScore  Int
  createdAt DateTime @default(now())

  @@index([resumeId, createdAt])
}

// Single-row admin config: which resume sections are treated as mandatory for completion/ATS
// purposes. Seeded with sensible defaults; admins can edit via the CMS.
model ResumeFieldConfig {
  id                String   @id @default("default")
  mandatorySections Json // string[] of section keys, e.g. ["summary","education","skills","projects"]
  updatedAt         DateTime @updatedAt
}

// Lightweight admin -> student feedback notes on a resume ("Suggest improvements"), separate
// from the auto-generated ATS suggestions.
model ResumeFeedback {
  id        String   @id @default(uuid())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  authorName String
  message   String
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// ===================================================================
// Student Profile Completion. Holds only the identity/academic fields not already modeled
// elsewhere — name/email/mobile/gender/profilePhotoUrl live on User, education history and the
// mandatory resume upload are satisfied by the student already having a Resume row with >=1
// education entry (see backend/src/utils/studentProfileCompletion.js, the single source of truth
// for what "complete" means — reused by the save route, the login payload, and admin stats so
// nothing ever trusts a client-computed completion flag).
// ===================================================================
model StudentProfile {
  id        String @id @default(uuid())
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String @unique

  personalEmail String?
  dob           DateTime?
  address       String?
  state         String?
  district      String?
  pincode       String?
  fatherName    String?
  fatherContact String?
  motherName    String?
  motherContact String?
  shortDescription String?

  // Optional "Skills & Capabilities" handles not already covered by the Resume model's
  // github/linkedin/portfolio fields.
  leetcodeHandle   String?
  hackerrankHandle String?
  stopstalkHandle  String?
  amcatId          String?
  cocubesId        String?

  // Placement Registration (Placement Cell foundations) — a student's explicit opt-in/out,
  // visible to Staff/Clerk/Admin, editable by the student at any time.
  placementParticipation String?   // "INTERESTED" | "NOT_INTERESTED"
  placementDeclineReason String?   // HIGHER_STUDIES | GOVT_EXAM | ENTREPRENEURSHIP | FAMILY_BUSINESS | EMPLOYED | NOT_INTERESTED | OTHER
  placementDeclineOther  String?
  placementUpdatedAt     DateTime?

  // Two independent placement-eligibility evaluations (Placement Clerk Analytics pass) — Staff's
  // academic/department judgement and the Placement Cell's own judgement never overwrite each
  // other. Internal tracking only: never read by any LMS/course-access gate, never shown to the
  // student. "SetBy" stores the evaluator's name (not a FK) — same audit-trail convention as
  // Certificate.revokedByName.
  departmentEligibility      String?   // "ELIGIBLE" | "NOT_ELIGIBLE"
  departmentEligibilitySetBy String?
  departmentEligibilitySetAt DateTime?
  clerkEligibility           String?   // "ELIGIBLE" | "NOT_ELIGIBLE"
  clerkEligibilitySetBy      String?
  clerkEligibilitySetAt      DateTime?

  // Talent Pool auto-selection criterion. Admin/Staff-set only (see profile.js's PATCH
  // /students/:studentId/cgpa) — deliberately NOT in the student's own self-editable field list,
  // same "setBy/setAt audit trail, not a raw FK" convention as departmentEligibility above.
  cgpa      Float?
  cgpaSetBy String?
  cgpaSetAt DateTime?

  mandatoryStatus      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  mandatoryCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Company Master (Placement Cell foundations) — a shared, admin/clerk-maintained list of
// employers, reused wherever a student would otherwise type a free-text company name (currently:
// Resume.experience entries, which gain an optional companyId key inside their existing JSON
// shape — no schema change needed there).
model Company {
  id              String   @id @default(uuid())
  name            String   @unique
  logoUrl         String?
  companyType     String?
  website         String?
  isActive        Boolean  @default(true)
  createdByUserId String
  createdByName   String
  createdAt       DateTime @default(now())

  // No separate @@index([name]) — `name` is already @unique above, which creates its own index;
  // an explicit duplicate index here was pure write overhead with zero query benefit.
}

enum OfferVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Placement Clerk Analytics pass — a student-submitted record of one placement/internship offer.
// A documentary proof link is mandatory (validated at creation in placementOffers.js, not just
// here) so every persisted row already satisfies the platform's "completion criteria" — there is
// no separate incomplete/draft state to track. companyName is always populated (mirrored from
// Company.name or the student's free-text "Other" entry) so company-wise analytics never need a
// join; companyId is kept only for linking back to Company Master when available.
model PlacementOffer {
  id        String @id @default(uuid())
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  companyId   String?
  companyName String

  offerType      String // "INTERNSHIP" | "PLACEMENT"
  source         String // "ON_CAMPUS" | "OFF_CAMPUS"
  offeredPackage Float  // LPA for PLACEMENT, monthly stipend for INTERNSHIP — unit implied by offerType
  offerStatus    String  @default("HOLDING") // "HOLDING" | "ACCEPTED" | "REJECTED"
  joiningStatus  String? // "Joined" | "Not Yet Joined" | "Deferred"
  proofLink      String

  // Editing any field of a VERIFIED or REJECTED offer resets it to PENDING (re-verification on
  // edit) — see placementOffers.js's PATCH /offers/:id.
  verificationStatus OfferVerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedByName     String?
  verifiedAt         DateTime?
  rejectionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REUPLOAD_REQUIRED
}

// Placement document management — a student-submitted shareable link for one supporting document
// (Resume, Aadhaar, mark sheet, etc.), verified by Staff/Clerk/Admin the same way PlacementOffer
// is. No in-house file storage exists on this platform (see PlacementOffer.proofLink) so this is
// a link, not an uploaded file. Offer letters are deliberately not a documentType here — they're
// already covered by PlacementOffer.proofLink. Multiple rows per (studentId, documentType) are
// allowed on purpose: MARKSHEET and OTHER naturally need several, and it keeps this model simple
// (no special-cased uniqueness) for the fixed types too, where the frontend just shows the latest.
model StudentDocument {
  id        String @id @default(uuid())
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  documentType String
  label        String?
  documentLink String

  // Editing a VERIFIED/REJECTED/REUPLOAD_REQUIRED document resets it to PENDING (re-verification
  // on edit) — same rule as PlacementOffer.
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedByUserId   String?
  verifiedByName     String?
  verifiedAt         DateTime?
  rejectionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

// ===================================================================
// Interview Prep Module. The spec describes 10 tables (interview_sessions,
// interview_questions, interview_answers, interview_reports,
// resume_analysis, coding_interviews, hr_interviews, technical_interviews,
// aptitude_interviews, mock_interviews) — consolidated here into 5 real
// models instead: HR/Technical/Coding/Aptitude are categories on ONE
// question bank and ONE session model (not 4 near-duplicate table sets),
// Mock is just a session whose questions span multiple categories, and
// Resume-based reuses the existing Resume model directly rather than a
// separate resume_analysis table (Resume already IS the analyzed,
// structured data). This is a deliberate normalization, not a missing
// feature — every category in the spec is still fully representable.
// ===================================================================

enum InterviewCategory {
  HR
  TECHNICAL
  CODING
  APTITUDE
  SYSTEM_DESIGN
  BEHAVIORAL
  MANAGERIAL
}

enum AptitudeCategory {
  QUANTITATIVE
  LOGICAL
  VERBAL
  DATA_INTERPRETATION
}

// AI-generated-content workflow status — shared by InterviewQuestionDraft and CompanyPatternNote.
// PENDING rows are never visible to students; only an explicit admin approve/reject action moves
// a row out of PENDING (see interviewDrafts.js's approve/reject routes).
enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
}

// Admin-set-only labels on an already-live InterviewQuestion (see frequencyTag below) — these are
// a human's editorial judgment call at approval time, never auto-assigned by the AI generator, so
// "Trending"/"Frequently Asked" is never presented as a fabricated real-world statistic.
enum FrequencyTag {
  FREQUENTLY_ASKED
  RECENTLY_ASKED
  TRENDING
  COMPANY_SPECIFIC
}

enum PackageBand {
  LPA_3_5
  LPA_5_10
  LPA_10_20
  LPA_20_PLUS
}

enum ExperienceLevel {
  FRESHER
  EXPERIENCED
}

// Unified question bank. Which fields apply depends on `category`:
// HR/TECHNICAL use expectedKeywords+modelAnswer (free-text, heuristically
// graded); APTITUDE uses options+correctAnswer (exact-match, like a quiz);
// CODING uses starterCode+testCases+language (graded by the real judge).
// Resume-based interview questions are generated on the fly at session
// start and inserted here with `generatedForStudentId` set, so they still
// flow through the same InterviewAnswer/evaluation pipeline as bank
// questions — they just aren't reusable across students.
model InterviewQuestion {
  id                    String   @id @default(uuid())
  category              InterviewCategory
  subject               String? // Technical: "Java","Python","SQL","DBMS","OS","CN","OOP","DSA",...; Coding: topic e.g. "Arrays"
  company               String? // e.g. "TCS", "Amazon" — set only for company-specific question-bank entries; null = general pool
  aptitudeCategory       AptitudeCategory?
  difficulty            Difficulty @default(EASY)
  title                 String? // Coding: problem title — parity with Question, optional so existing prompt-only rows keep working
  prompt                String
  expectedKeywords      Json?   // HR/Technical: string[] of concepts to look for in a free-text answer
  modelAnswer           String? // HR/Technical: shown after the student answers
  options               Json?   // Aptitude: string[]
  correctAnswer         Json?   // Aptitude: correct option index
  explanation           String? // Aptitude: shown after
  starterCode           String? // Coding
  starterCodeByLanguage Json?   // Coding: { java, python, cpp, c, javascript } — preferred when present, same as Question
  testCases             Json?   // Coding: [{input, expected, isHidden?}] — isHidden absent/false = sample case
  language               String? // Coding: default language
  tags                  Json?   // Coding: string[] — parity with Question.tags

  // Coding: LeetCode-style function-only submissions — same STDIO/FUNCTION split as Question, see
  // functionHarness.js.
  evaluationType    String @default("STDIO")
  functionSignature Json?

  // "Professional structure" fields (Coding category only) — see the identically-named block on
  // Question above for the full rationale; kept in sync field-for-field.
  estimatedTimeMin   Int?
  realWorldScenario  String?
  constraints        String?
  inputFormat        String?
  outputFormat       String?
  notes              String?
  edgeCases          String?
  problemExplanation String?

  // Editorial/hints block (Coding category only) — see the identically-named block on Question
  // above for the full rationale; kept in sync field-for-field.
  hints            Json?
  timeComplexity   String?
  spaceComplexity  String?
  editorial        Json?
  similarQuestions Json?

  generatedForStudentId String? // set only for ephemeral resume-based questions
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  // Browse/catalog metadata for the AI-Powered Auto-Updating Mock Interview System — deliberately
  // NOT read by sanitizeQuestion() (the mid-session student payload), only by the catalog-browse
  // endpoints, so these never bleed into a live interview. frequencyTag is set by a human only,
  // at draft-approval time (see InterviewQuestionDraft below) — never auto-assigned by the AI
  // generator, so it can never be a laundered fabricated statistic.
  frequencyTag     FrequencyTag?
  packageBand      PackageBand?
  experienceLevel  ExperienceLevel?

  // Rule-based "adaptive" follow-up: when an admin links a natural next question (e.g. "Explain
  // JVM" -> "How does JVM differ from JRE?"), answering this question inserts that one as the
  // next question in the session. Deterministic and admin-authored, not a real NLU model
  // generating a follow-up from the semantic content of the answer — genuinely understanding an
  // arbitrary free-text answer well enough to ask a *good* dynamic follow-up is a real LLM
  // capability this platform doesn't have (see "no real AI anywhere" elsewhere in this file).
  followUp   InterviewQuestion?  @relation("QuestionFollowUp", fields: [followUpQuestionId], references: [id])
  followUpQuestionId String?
  followUpOf InterviewQuestion[] @relation("QuestionFollowUp")

  answers InterviewAnswer[]

  @@index([category])
  @@index([subject])
  @@index([company])
  @@index([generatedForStudentId])
  @@index([frequencyTag])
  @@index([packageBand])
  @@index([experienceLevel])
}

// AI-generated candidate question, held here — structurally separate from InterviewQuestion —
// until an admin explicitly approves it. This is a deliberate structural guarantee rather than a
// status-filter convention: pickQuestions() and every other student-facing query only ever reads
// InterviewQuestion, a table this model's rows never touch until POST /admin/drafts/questions/:id/approve
// performs an explicit create — there is no code path by which a PENDING row can reach a real
// interview session. Mirrors InterviewQuestion's own field set field-for-field so the approve step
// is a straight copy, plus the review/audit metadata below.
model InterviewQuestionDraft {
  id                    String   @id @default(uuid())
  category              InterviewCategory
  subject               String?
  company               String?
  aptitudeCategory      AptitudeCategory?
  difficulty            Difficulty @default(EASY)
  title                 String?
  prompt                String
  expectedKeywords      Json?
  modelAnswer           String?
  options               Json?
  correctAnswer         Json?
  explanation           String?
  starterCode           String?
  starterCodeByLanguage Json?
  testCases             Json?
  language              String?
  tags                  Json?

  evaluationType    String @default("STDIO")
  functionSignature Json?

  estimatedTimeMin   Int?
  realWorldScenario  String?
  constraints        String?
  inputFormat        String?
  outputFormat       String?
  notes              String?
  edgeCases          String?
  problemExplanation String?

  status            DraftStatus @default(PENDING)
  sourceRun         String?  // batch id — set when created by the Phase 5 scheduler, null for an admin-triggered one-off generate
  generatedAt       DateTime @default(now())
  reviewedByAdminId String?
  reviewedAt        DateTime?
  rejectionReason   String?
  approvedQuestionId String? // set once promoted — the resulting InterviewQuestion.id, for audit traceability

  @@index([status])
  @@index([company])
  @@index([category])
}

// AI-drafted "hiring pattern" checklist for a company+category (e.g. Amazon/CODING ->
// ["OA Questions","Interview Questions"]), same PENDING/APPROVED/REJECTED review gate as
// InterviewQuestionDraft. Only APPROVED rows are ever returned by GET /companies/:company/pattern,
// and that response is always wrapped `{ aiEstimated: true, ... }` — this is AI-estimated pattern
// commentary, never presented as verified company data.
model CompanyPatternNote {
  id                String      @id @default(uuid())
  company           String
  category          InterviewCategory
  checklistItems    Json        // string[]
  status            DraftStatus @default(PENDING)
  sourceRun         String?     // batch id — set when created by the Phase 5 scheduler, null for an admin-triggered one-off generate
  generatedAt       DateTime    @default(now())
  reviewedByAdminId String?
  reviewedAt        DateTime?

  @@index([status])
  @@index([company])
}

// Legally-safe, general-knowledge interview pattern for one company — topic emphasis, difficulty
// mix, and round structure, sourced from the kind of thing every interview-prep book/blog already
// publishes (e.g. "Amazon interviews emphasize Leadership Principles + arrays/hashmaps"). Same
// framing as CompanyPatternNote above (AI-estimated, never a claim about a specific real question),
// but this is the structured config pickQuestions() actually reads to weight selection, not a
// human-readable checklist. Missing category in categoryWeights, or no row at all for a company =
// today's plain shuffle for that category — every field here is purely additive to selection
// behavior, never a hard requirement.
model CompanyInterviewProfile {
  id       String  @id @default(uuid())
  company  String  @unique
  isActive Boolean @default(true)

  // { CODING: { topicWeights: {"Arrays": 0.3, "Hashmap": 0.25, ...}, difficultyMix: {EASY:0.3,MEDIUM:0.5,HARD:0.2} }, HR: {...}, ... }
  categoryWeights Json?

  // Ordered round definitions for a Company Round session:
  // [{ roundNumber, category, count, eliminationThreshold, label }, ...]
  // eliminationThreshold: null = no elimination check for that round (used on the last round).
  // No roundPlan at all = today's flat HR(2)+Technical(3)+Coding(2)+Managerial(2) composition.
  roundPlan Json?

  notes            String? // e.g. "Sourced from general public interview-prep guidance"
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([company])
}

// One row per attempt. `category` HR/TECHNICAL/CODING/APTITUDE is a focused single-type
// session; a Mock session sets isMock=true and its questions span multiple categories
// (config.mix records the composition). Resume-based sessions set isResumeBased=true and
// their questions are the ephemeral generatedForStudentId rows created for this student.
model InterviewSession {
  id             String   @id @default(uuid())
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  category       InterviewCategory?  // null for a pure mock/company-round session spanning categories
  isMock         Boolean  @default(false)
  isResumeBased  Boolean  @default(false)
  isCompanyRound Boolean  @default(false) // HR + Technical + Coding + Managerial, all filtered by config.company
  status         String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, TERMINATED (proctoring violations exceeded)
  violationCount Int      @default(0)
  terminationReason String? // e.g. "MAX_VIOLATIONS", set only when status = TERMINATED
  config         Json?    // {difficulty, subject, language, aptitudeCategory, negativeMarking, durationMin, topic, mix, company, jobRole, experienceLevel}
  startedAt      DateTime @default(now())
  submittedAt    DateTime?

  // Talent Pool exclusivity: set only when this session was started against a pool's interview
  // config (see interview.js POST /sessions' talentPoolConfigId branch). SetNull (not Cascade) —
  // deleting the config later must not delete the student's completed session history.
  talentPoolConfig   TalentPoolInterviewConfig? @relation(fields: [talentPoolConfigId], references: [id], onDelete: SetNull)
  talentPoolConfigId String?

  // Round-elimination — populated only for Company Round sessions whose company has an active
  // CompanyInterviewProfile.roundPlan; every other session leaves these at their defaults and
  // behaves exactly as before this feature existed. roundPlanSnapshot is copied at session-start
  // so a later admin edit to the profile never retroactively changes an in-flight or already-
  // completed session's rules.
  roundPlanSnapshot  Json?    // copy of CompanyInterviewProfile.roundPlan at session start
  currentRoundNumber Int      @default(1)
  roundResults       Json?    // [{roundNumber, category, label, score, status: PASSED|ELIMINATED|NOT_REACHED|IN_PROGRESS, questionIds, answeredCount}]
  eliminatedAtRound  Int?     // set once, null = never eliminated (or not a round-elimination session)

  answers    InterviewAnswer[]
  report     InterviewReport?
  violations InterviewViolation[]

  @@index([studentId, category])
  @@index([studentId, status])
  @@index([talentPoolConfigId])
}

// Event-level proctoring log for interview sessions — mirrors ProctoringViolation (the module-
// coding equivalent) but kept as its own model rather than a shared polymorphic one, same
// "sibling model over a complicated shared one" call made there. `penalized` distinguishes
// events that count toward the 3-strike auto-terminate threshold (tab switch, fullscreen exit,
// camera/mic dropped) from ones that are only logged for review (face missing briefly, multiple
// faces detected — explicitly "future ready, log don't penalize" per spec).
model InterviewViolation {
  id        String   @id @default(uuid())
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  type      String
  penalized Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model InterviewAnswer {
  id           String   @id @default(uuid())
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    String
  // Restrict, not Cascade: an InterviewQuestion can be shared across many students' sessions —
  // deleting it from the question bank must not silently erase historical answers/scoring detail
  // from past completed interviews. Deleting the SESSION itself still cascades its answers above
  // (that's a genuine cleanup, not data loss of shared content).
  question     InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId   String
  answerText   String?  // HR/Technical free-text (or Web-Speech-API transcript), or Aptitude selected option index as a string
  code         String?  // Coding
  language     String?  // Coding
  skipped      Boolean  @default(false)
  timeTakenSec Int?
  score        Int      @default(0) // 0-100, this question only
  breakdown    Json?    // category-specific sub-scores, see utils/interviewEvaluation.js
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
}

// Finalized per-session feedback snapshot — persisted (not recomputed on every read) so a
// student's history stays stable even if scoring heuristics change later.
model InterviewReport {
  id              String   @id @default(uuid())
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       String   @unique
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  overallScore    Int
  scoreBreakdown  Json    // e.g. {communication, confidence, vocabulary, professionalism, completeness} or {correctness, codeQuality}
  strongAreas     Json    // string[]
  weakAreas       Json    // string[]
  recommendations Json    // string[]

  // Round-elimination / richer-feedback additions — all nullable, populated only where relevant
  // (Company Round sessions with a matched profile for companyReadinessScore; every session gets
  // timeEfficiency/optimizationSuggestions since those are pure arithmetic over data already
  // captured on InterviewAnswer, not profile-dependent).
  companyReadinessScore   Int?  // overallScore blended with round-completion % for round-elimination sessions; falls back to overallScore for everything else
  timeEfficiency          Json? // { avgTimePerQuestionSec, byCategory: {...}, comparedToBudget: "under"|"on-pace"|"over" }
  optimizationSuggestions Json? // string[] — pacing/structure advice, distinct from the weak-area-driven `recommendations` above

  createdAt       DateTime @default(now())

  @@index([studentId, createdAt])
}

model InterviewCertificate {
  id              String   @id @default(uuid())
  certificateCode String   @unique
  // Restrict, not Cascade — same reasoning as Certificate.student above.
  student         User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId       String   @unique
  averageScore    Int
  issuedAt        DateTime @default(now())
}

// ===================== Attendance Management =====================
// Institute → Department → Division → Class → Student. Department/Division are new — this
// platform's existing hierarchy was Institute → Class → Student, with no structured department
// or division concept (User.department was a free-text tag, not a relation). Both are admin-
// managed and additive: existing Class rows start with divisionId = null and remain fully
// functional for every other feature (tests, learning, etc.); a Class only needs a Division once
// an admin wants to take attendance for it.

model Department {
  id          String    @id @default(uuid())
  name        String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  divisions      Division[]
  academicGroups AcademicGroup[]
  resultExaminationTags ResultExaminationDepartment[]

  @@unique([instituteId, name])
}

model Division {
  id           String     @id @default(uuid())
  name         String     // e.g. "A", "Division 1"
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  classes Class[]

  @@unique([departmentId, name])
}

// Institute -> Batch -> Department -> Section: the platform-wide replacement for Class/Division as
// the real student-grouping/enrollment mechanism. Rows are auto-created (find-or-create by the
// unique tuple below) from Bulk Upload/Registration and the one-time migration script — there is no
// manual "create a group" admin flow, mirroring the Attendance module's existing "no standalone
// entity" principle. batch/section are plain strings (no separate Batch/Section model), matching
// the existing Class.batchYear / Division.name conventions.
model AcademicGroup {
  id           String     @id @default(uuid())
  institute    Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId  String
  batch        String     // e.g. "2025-2028", or "Unassigned" for pre-migration classes with no batch
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  section      String     // e.g. "Section A"
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  users            User[]
  testAssignments  TestAcademicGroup[]
  staffAssignments StaffClassAssignment[]
  courseAssignments CourseAcademicGroupAssignment[]
  dailyChallenges  DailyChallenge[]
  weeklyChallenges WeeklyChallenge[]
  readinessSubjectAssignments ReadinessSubjectAcademicGroup[]

  @@unique([instituteId, batch, departmentId, section])
  @@index([instituteId])
  @@index([departmentId])
  @@index([instituteId, batch])
}

// ===================================================================
// Result Management — manual marksheets for offline/manually-conducted exams (placement
// readiness tests, mock tests, internal assessments). Deliberately independent of the online
// Test/ModuleCodingTest/Interview engines above: nothing here is timed, graded by a judge, or
// proctored — an Admin enters marks that were determined outside the platform, and this module
// only handles storing/publishing/presenting them as a digital marksheet. Reuses Student/
// Institute/Department/Notification wholesale rather than duplicating any of it.
// ===================================================================

enum ResultExaminationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum ResultEntrySource {
  MANUAL
  BULK_IMPORT
}

model ResultExamination {
  id          String    @id @default(uuid())
  title       String
  description String?
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  instituteId String
  batch       String? // free-text, matches AcademicGroup.batch convention — informational, not an eligibility gate
  // Free-text list of sections (what the spec calls "Division(s)"), e.g. "A, B" — informational
  // only, same role as `batch`. AcademicGroup.section (a plain string, not a relation) is the
  // actual modern division field a student is scoped by, so this is deliberately NOT a relation to
  // the legacy Division model (Department -> Division -> Class), which no current student
  // enrollment is tied to.
  divisions   String?
  // Free-text, same informational convention as batch/divisions — no field on User/AcademicGroup
  // carries "semester" today, so it's scoped to the exam itself rather than the student.
  semester    String?

  examDate    DateTime
  // Informational only — no scheduler reads this field. "Publish Later" just means the admin
  // records an intended date and comes back to click Publish themselves.
  publishDate DateTime?

  totalMarks     Float
  passingMarks   Float?
  passingPercent Float?
  // Configurable wording so a Pass/Fail exam and a Qualified/Not Qualified exam can share the same
  // underlying `passed` boolean on ResultEntry without this model needing a second status axis.
  passLabel String @default("Pass")
  failLabel String @default("Fail")

  status           ResultExaminationStatus @default(DRAFT)
  allowPdfDownload Boolean                 @default(true)

  // Marksheet "premium" opt-in extras — all default off, per the spec's own "(if enabled)"/
  // "(optional)" wording. Rank/class average are computed on demand from this exam's ResultEntry
  // rows (see utils/resultRank.js), never stored. Attendance % (when shown) is the student's
  // overall attendance at the institute, not scoped to this exam's date range — exams have no
  // term/subject linkage to attendance sessions, so this is a deliberate simplification.
  showRank         Boolean @default(false)
  showClassAverage Boolean @default(false)
  showAttendance   Boolean @default(false)

  createdByAdminId String
  createdByName    String
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  departments ResultExaminationDepartment[]
  entries     ResultEntry[]

  @@index([instituteId])
  @@index([instituteId, status])
}

// Purely descriptive/filter tagging on the exam (which departments it broadly covers, for
// Search/Export/Analytics) — NOT an eligibility gate. Which students actually have a result is
// determined entirely by which ResultEntry rows exist, the same way every other "which students
// does this apply to" question on this platform is answered by the join-row data rather than a
// separate access list. Mirrors TestAcademicGroup's join-table shape.
model ResultExaminationDepartment {
  id            String            @id @default(uuid())
  examination   ResultExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId String
  department    Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId  String

  @@unique([examinationId, departmentId])
}

// One row per student per examination. percentage/passed are computed at write time (on create,
// on entry edit, and on every entry when the exam's totalMarks/passingMarks/passingPercent
// changes) — never recalculated live on every read, the same materialized-computed-value posture
// as Submission.score elsewhere on this platform. `grade` is a plain optional admin-entered field,
// deliberately never auto-computed — this platform has no standing grading-scale policy to encode,
// and fabricating one would misrepresent the institute's actual grading system.
model ResultEntry {
  id            String            @id @default(uuid())
  examination   ResultExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  examinationId String
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String

  obtainedMarks Float
  percentage    Float
  passed        Boolean
  grade         String?
  // Admin-entered only, never derived from percentage — same "never fabricate the institute's
  // grading/assessment policy" reasoning as `grade` above.
  remarks       String?

  // Public marksheet-verification ID (format: MS-<year>-<instituteCode>-<random>, generated by
  // utils/resultCode.js — mirrors Certificate.certificateCode). Nullable: existing rows created
  // before this feature shipped get one lazily, the first time anyone views/downloads their
  // marksheet (see utils/resultMarksheetData.js), rather than a one-off backfill migration.
  verificationCode String? @unique

  enteredByAdminId String
  enteredByName    String
  source           ResultEntrySource @default(MANUAL)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([examinationId, studentId])
  @@index([studentId])
  @@index([examinationId])
}

// Admin-managed: which single staff member owns attendance for a division (Class). One division =
// one staff assignment — enforced by the write route (routes/attendance.js's find-by-classId-then-
// update-or-create logic), not a DB unique constraint, so re-assigning a division to a different
// staff member updates this same row rather than creating a duplicate. Subject now lives on
// LecturePlan (entered per lecture, not fixed per assignment) since a division's teacher can cover
// multiple subjects across different lectures.
model StaffClassAssignment {
  id      String @id @default(uuid())
  staff   User   @relation("StaffClassAssignments", fields: [staffId], references: [id], onDelete: Cascade)
  staffId String
  // Legacy Class-based link — nullable so new assignments can be created via academicGroupId alone
  // once the Attendance cutover phase ships. Kept (not dropped) for existing rows' rollback safety.
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String?
  // Institute -> Batch -> Department -> Section replacement for the class/division link above.
  academicGroup   AcademicGroup? @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  academicGroupId String?

  // A third, mutually-exclusive roster type alongside class/academicGroup above: "the students of
  // ONE institute within a (possibly multi-institute) Talent Pool." Lets a Talent Pool's
  // attendance-mandatory assessments reuse the exact same LecturePlan/AttendanceSession/
  // AttendanceRecord/ExecuteAttendance machinery as ordinary division-based attendance, instead of
  // a parallel implementation — see routes/talentPools.js's attendance-owners routes (the only
  // writers of these two fields) and routes/attendance.js's resolveAssignmentAccess/
  // rosterWhereForAssignment, which branch on talentPoolId being set. Existing rows are unaffected
  // (both null, same code path as before this was added).
  talentPool            TalentPool? @relation("TalentPoolAttendanceOwners", fields: [talentPoolId], references: [id], onDelete: Cascade)
  talentPoolId          String?
  attendanceInstitute   Institute?  @relation("TalentPoolAttendanceInstitute", fields: [attendanceInstituteId], references: [id], onDelete: Cascade)
  attendanceInstituteId String?

  // Free text (programs vary in term count/naming across institutes) — mutable; a division's
  // assignment carries across semesters and an admin can just update it rather than recreating.
  semester String @default("")

  // A class has multiple subjects taught by different faculty, so one academic group now supports
  // many assignments — one per subject, not one per group. @default("") makes this backward
  // compatible with every existing row (all pre-dating this field), and since the app-level "one
  // row per academicGroupId" rule already held before this was added, every existing row's
  // (academicGroupId, "") pair is automatically unique — no backfill script needed. See
  // routes/attendance.js's POST/PATCH /admin/staff-assignments for the write-side enforcement.
  subject String @default("")

  assignedAt DateTime @default(now())

  lecturePlans LecturePlan[]

  @@index([classId])
  @@index([academicGroupId])
  @@index([staffId])
  @@index([talentPoolId])
  // Real constraint (unlike the academicGroup path, which relies on route logic alone) — this is
  // a brand-new pairing with no legacy rows to worry about, and the spec explicitly requires
  // preventing duplicate attendance-ownership assignments for the same institute within a pool.
  @@unique([talentPoolId, attendanceInstituteId])
  // One staff per subject per academic group — this is what actually turns "always exactly one
  // assignment row per group" into "one row per (group, subject) pair." NULL academicGroupId
  // (talent-pool-only assignments) never collides here since Postgres treats every NULL as
  // distinct in a composite unique index, same reasoning as the constraint above.
  @@unique([academicGroupId, subject])
}

enum LectureType {
  REGULAR
  PRACTICE_TEST
  EXAM
}

// The "Add Plan" entity — a scheduled lecture for a division assignment, created ahead of (and
// independently from) marking attendance. lectureNumber is explicit (manually assigned or
// imported), scoped per-assignment so lectures for the same division never collide. subject is
// entered per-plan (not fixed on the assignment) since one division's teacher can cover several
// subjects across different lectures; @default("") exists only so `prisma db push` can backfill
// any plans already created before this field existed — every write path still requires a real
// value at the application layer.
model LecturePlan {
  id           String               @id @default(uuid())
  assignment   StaffClassAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  lectureNumber Int
  subject      String @default("")
  topic        String
  scheduleDate DateTime // calendar date this lecture is scheduled for (time-of-day not meaningful)
  // "Slot 1".."Slot 7" or "Other" — startTime/endTime are always stored explicitly (even for the
  // fixed slots) so the scheduled-lecture list and Excel import don't need a second lookup table.
  slotLabel    String
  startTime    String // e.g. "09:50"
  endTime      String // e.g. "10:45"
  lectureType  LectureType @default(REGULAR)
  // Set only for a Talent Pool attendance owner's auto-generated plans (see routes/attendance.js's
  // syncTalentPoolPlans) — pins this plan to the exact Test it represents, so re-syncing is
  // idempotent (never creates a second plan for the same test) and Execute can skip the manual
  // eligible-test dropdown, already knowing which Test to mark attendance for. Always null for the
  // regular, manually-created division/class plans this model was originally built for — the
  // @@unique below only constrains rows where it's actually set (Postgres treats every NULL as
  // distinct), so it can never collide with the existing regular-plan workflow.
  test         Test?       @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId       String?
  createdBy    User     @relation("LecturePlanCreatedBy", fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session AttendanceSession?

  @@unique([assignmentId, lectureNumber])
  @@unique([assignmentId, testId])
  @@index([assignmentId, scheduleDate])
  @@index([createdById])
}

// The "Execute Attendance" record — created only once a plan's attendance is actually marked
// (1:1 with LecturePlan, hence @unique on planId). markedBy/markedAt are set once, at first save;
// updatedBy/updatedAt track every subsequent edit, giving the audit trail the Edit flow needs
// without ever losing who originally took the roll call.
model AttendanceSession {
  id          String      @id @default(uuid())
  plan        LecturePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String      @unique
  // Only meaningful when the plan's lectureType is PRACTICE_TEST/EXAM — links this attendance to
  // the actual Test being administered, reusing the existing Test module instead of duplicating
  // exam metadata. Must be an isPublished, attendanceMandatory-enabled, currently-active Test.
  test        Test?       @relation(fields: [testId], references: [id])
  testId      String?
  markedBy    User        @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedById  String
  markedAt    DateTime    @default(now())
  updatedBy   User?       @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?
  updatedAt   DateTime    @updatedAt

  records AttendanceRecord[]

  @@index([testId])
  @@index([markedById])
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  student   User              @relation("AttendanceStudentRecords", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  status    String            @default("PRESENT") // PRESENT | ABSENT | LATE | LEAVE

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// Backs a Postgres-based rate limiter (backend/src/utils/dbRateLimit.js) for the login and
// forgot-password endpoints specifically. Live testing against the deployed backend showed
// express-rate-limit's in-memory store does not reliably enforce its limit there — the remaining-
// attempts counter was observed resetting mid-window across sequential requests, consistent with
// more than one backend process each holding its own independent in-memory Map. A database every
// deployment already has is correct regardless of how many app processes exist; other, lower-
// sensitivity limiters in this codebase (the global limiter in index.js, the code-execution
// limiters in submissions.js/moduleCoding.js) still use express-rate-limit's in-memory store and
// were not changed here, since this fix was scoped to the two endpoints actually reported.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String // e.g. "login:<ip>:<email>" or "forgot-password:<ip>" — see dbRateLimit.js
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ===================================================================
// Employability & Subject Readiness Assessment module.
//
// Deliberately reuses the existing Question/QuestionFolder/institute-scoping architecture rather
// than creating a parallel question bank — see the btlLevel/subtopic/skillTested/questionStatus/
// aiGenerated fields added directly to Question above. What genuinely doesn't exist anywhere else
// on the platform (and is added here) is: (1) an admin-configurable Subject taxonomy with topics/
// subtopics and a BTL-distribution blueprint, since Question.subject/topic are just free strings
// with no owning hierarchy; (2) a session-based attempt+report pair for this assessment type,
// modeled on InterviewSession/InterviewAnswer/InterviewReport (dynamic per-student question sets,
// multi-dimensional Json breakdown scoring) rather than the Formal Test model (admin-scheduled,
// fixed roster, proctoring-heavy) — a Readiness assessment is closer in shape to a mock interview
// than to a scheduled exam.
// ===================================================================

// Admin-authored subject definition: the topic/subtopic taxonomy and default BTL distribution a
// Readiness assessment blueprint is built from. instituteId null = platform-wide (usable by every
// institute, same "null = shared" convention as Question.instituteId/QuestionFolder.instituteId).
model ReadinessSubject {
  id          String   @id @default(uuid())
  name        String
  code        String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  instituteId String?
  department  String?  // free-text, matches User.department's convention — not FK'd
  program     String?  // free-text, matches User.program's convention — not FK'd
  description String?

  // [{ name: string, subtopics: string[] }]
  topics Json

  // Which of the platform's existing QuestionType values this subject's assessments may draw
  // from (a subset of the Question model's QuestionType enum — no new question types introduced).
  questionTypesAllowed Json // string[] of QuestionType values

  // Percentages keyed by BTL level 1-6, admin-configured, need not sum to exactly 100 for every
  // subject (the blueprint resolver in the Readiness engine normalizes at question-count time) —
  // e.g. { "1": 10, "2": 15, "3": 25, "4": 25, "5": 15, "6": 10 }.
  defaultBtlDistribution Json

  // Named assessment modes this subject supports, each with its own BTL range — e.g.
  // [{ key: "FOUNDATION", label: "Foundation Readiness", btlMin: 1, btlMax: 2 },
  //  { key: "APPLICATION", label: "Application Readiness", btlMin: 3, btlMax: 3 },
  //  { key: "PROBLEM_SOLVING", label: "Problem-Solving Readiness", btlMin: 3, btlMax: 4 },
  //  { key: "INTERVIEW", label: "Interview Readiness", btlMin: 2, btlMax: 5 },
  //  { key: "ADVANCED", label: "Advanced Employability Readiness", btlMin: 4, btlMax: 6 },
  //  { key: "COMPLETE", label: "Complete Subject Employability Assessment", btlMin: 1, btlMax: 6 }]
  assessmentModes Json

  // Subject-specific employability indicator groups shown on the report (spec section 23) — e.g.
  // DBMS: ["SQL","Database Design","Transactions","Query Optimization"]; DSA: ["Problem Solving",
  // "Complexity Analysis","Algorithms","Coding"]. Purely descriptive/report-shaping, not scored
  // independently of the topic/BTL breakdown already computed.
  employabilityIndicators Json?

  defaultDurationMin Int  @default(45)
  passingPercent     Int  @default(50)

  // Certificate-on-completion policy (spec CRITICAL RULE: never auto-issue employment-readiness
  // certificates unless policy supports it — both fields default to "off"/unset so issuance stays
  // opt-in per subject, admin-configured). certificateMinLevel is one of ReadinessReport.readinessLevel's
  // 6 labels; issuance checks the student's report against it using the same READINESS_LEVEL_RANK
  // ordinal ranking already established in talentPoolAutoSelect.js.
  certificateEnabled  Boolean @default(false)
  certificateMinLevel String?

  // Admin-configurable readiness-level thresholds, evaluated top-down against overallScore — e.g.
  // [{ label: "EXCELLENTLY_READY", min: 90 }, { label: "JOB_READY", min: 75 },
  //  { label: "NEARLY_READY", min: 60 }, { label: "DEVELOPING", min: 45 },
  //  { label: "NEEDS_IMPROVEMENT", min: 25 }, { label: "FOUNDATION_REQUIRED", min: 0 }]
  readinessThresholds Json

  isActive  Boolean  @default(true)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments ReadinessAssessment[]
  academicGroupAssignments ReadinessSubjectAcademicGroup[]

  @@index([instituteId])
  @@index([createdById])
}

// Fine-grained grant: subject visible/startable only for students in this specific AcademicGroup
// (Institute+Batch+Department+Section) — mirrors CourseAcademicGroupAssignment exactly. Empty
// assignment set for a subject = open to the whole institute (or platform, if instituteId null),
// same "empty = open" convention as TestAcademicGroup/CourseAcademicGroupAssignment, so every
// pre-existing subject keeps working unchanged until an admin explicitly assigns it.
model ReadinessSubjectAcademicGroup {
  id               String           @id @default(uuid())
  subject          ReadinessSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId        String
  academicGroup    AcademicGroup    @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  academicGroupId  String
  // Optional further narrowing to one free-text program within the assigned group — matches
  // User.program's own convention (no FK anywhere on this platform, not part of AcademicGroup's
  // identity). Null = every program within the assigned academicGroup is eligible.
  program          String?
  assignedByUserId String
  assignedByName   String
  createdAt        DateTime         @default(now())

  @@unique([subjectId, academicGroupId, program])
  @@index([subjectId])
  @@index([academicGroupId])
}

// One student's attempt at a subject readiness assessment. Mirrors InterviewSession's shape: a
// dynamic, per-attempt question set (captured in `blueprint` for explainability/audit) rather than
// a fixed admin-scheduled roster.
model ReadinessAssessment {
  id          String   @id @default(uuid())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  subject     ReadinessSubject @relation(fields: [subjectId], references: [id])
  subjectId   String

  assessmentMode String // one of ReadinessSubject.assessmentModes[].key, or "CUSTOM"

  // The resolved BTL->questionCount target actually used to build this attempt (e.g.
  // { "1": 3, "2": 5, "3": 9, "4": 7, "5": 4, "6": 2 }) — stored so the report can always explain
  // exactly what was assessed, independent of whatever the subject's defaults are later changed to.
  blueprint Json

  status      String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | TERMINATED | EXPIRED
  startedAt   DateTime @default(now())
  submittedAt DateTime?
  durationMin Int
  config      Json? // adaptive-mode flag, any per-attempt overrides

  answers ReadinessAnswer[]
  report  ReadinessReport?

  @@index([studentId])
  @@index([subjectId])
  @@index([status])
}

model ReadinessAnswer {
  id           String   @id @default(uuid())
  assessment   ReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  question     Question @relation(fields: [questionId], references: [id])
  questionId   String

  answerText      String?
  code            String?
  language        String?
  selectedOptions Json? // array of 0-based option indices, for MCQ/MULTISELECT/TRUE_FALSE — needed
                        // to restore the student's picks on resume, since score/isCorrect alone
                        // can't reconstruct what was actually selected.
  skipped      Boolean  @default(false)
  score        Int      @default(0) // 0-100 for this one question
  isCorrect    Boolean?
  timeTakenSec Int?
  createdAt    DateTime @default(now())

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// Computed, stored result for one ReadinessAssessment — the single source of truth every
// dashboard/export reads from, so the UI and any exported PDF/Excel can never disagree (spec
// section 34). Mirrors InterviewReport's overall-score-plus-Json-breakdown shape.
model ReadinessReport {
  id           String   @id @default(uuid())
  assessment   ReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String   @unique
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String

  overallScore   Int    // 0-100, the documented weighted composite (see readinessScoring.js)
  readinessLevel String // one of ReadinessSubject.readinessThresholds[].label

  // { "1": {attempted,correct,percent} | null, ..., "6": ... } — a BTL level with zero questions
  // actually assessed in this attempt is stored as null, never as 0%, per spec section 19.
  btlScores Json

  // [{ topic, subtopic, questionsAttempted, accuracy, btlDistribution, strength }]
  topicScores Json

  // { EASY: percent|null, MEDIUM: percent|null, HARD: percent|null }
  difficultyScores Json

  // Only the dimensions actually assessed in this attempt are populated — e.g.
  // { knowledge, conceptual, application, analysis, evaluation, problemSolving, coding }
  dimensionScores Json

  // Snapshot of the subject's employabilityIndicators, each with a computed score
  employabilityIndicators Json?

  strongAreas    Json // string[]
  weakAreas      Json // string[]
  recommendations Json // [{ priority, topic, action }]
  nextAssessmentSuggestion String?

  createdAt DateTime @default(now())

  @@index([studentId])
}
